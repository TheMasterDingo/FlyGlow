{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Dragon's eye",
   "ru": "Глаз дракона"
  },
  "description": {
   "en": "A dragon's eye looks around and blinks; the scales can be turned off.",
   "ru": "Глаз дракона оглядывается и моргает, чешую можно выключить."
  },
  "controls": [
   {
    "type": "choice",
    "label": {
     "en": "Background",
     "ru": "Фон"
    },
    "options": [
     {
      "label": {
       "en": "Scales",
       "ru": "Чешуя"
      },
      "set": [
       {
        "layer": 0,
        "visible": true
       },
       {
        "layer": 1,
        "visible": false
       }
      ]
     },
     {
      "label": {
       "en": "Eye only",
       "ru": "Только глаз"
      },
      "set": [
       {
        "layer": 0,
        "visible": false
       },
       {
        "layer": 1,
        "visible": true
       }
      ]
     }
    ]
   },
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     },
     {
      "layer": 1
     }
    ],
    "base": "#006b29"
   }
  ],
  "cover": 0.05,
  "tags": [
   "dragon",
   "eye",
   "fantasy",
   "дракон",
   "глаз"
  ],
  "order": 120
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Dragon's eye",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Dragon's eye: a fiery iris with a slit pupil in green scales; it looks left and right, the pupil\n// widens and narrows, a glint of light runs over the scales, and once a loop it blinks.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nconst vec2 EC = vec2(0.0, -2.4);    // centre of the eye\nconst float W = 6.4;                // half its length\nconst bool SCALES = true;           // false: the eye alone on black\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float t = iPhase;\n\n    float look = -smoothstep(0.12, 0.2, t) + 2.0 * smoothstep(0.42, 0.5, t) - smoothstep(0.72, 0.8, t);\n    float pw = 0.7 + 0.9 * (smoothstep(0.54, 0.6, t) - smoothstep(0.66, 0.74, t));\n    float open = 1.0 - (smoothstep(0.88, 0.9, t) - smoothstep(0.915, 0.94, t));\n\n    // Scales: every LED one scale, a little lighter or darker; a glint sweeps across once a loop.\n    float h = hash(led.xy * 3.1 + 7.0);\n    vec3 col = vec3(0.0, 0.42, 0.16) * (0.55 + 0.6 * h);\n    float sweep = fract(t + 0.3) * 26.0 - 13.0;\n    col += vec3(0.5, 0.9, 0.3) * exp(-pow(p.x + 0.6 * p.y - sweep, 2.0) / 1.2) * (0.3 + 0.7 * h);\n    // A brow ridge of bigger, brighter scales over the eye.\n    float browY = EC.y - 3.3 - 0.0 * p.x;\n    if (abs(p.y - (browY + 0.06 * p.x * p.x)) < 0.45 && abs(p.x) < 6.5)\n        col = vec3(0.15, 0.75, 0.25) * (0.75 + 0.35 * h);\n    if (!SCALES)\n        col = vec3(0.0);\n\n    // The opening between the lids.\n    float f = clamp(1.0 - (p.x / W) * (p.x / W), 0.0, 1.0);\n    float up = EC.y - 2.7 * pow(f, 0.7) * open;\n    float lo = EC.y + 2.1 * pow(f, 0.7) * open;\n    float inEye = step(up, p.y) * step(p.y, lo) * step(0.05, open);\n    // The lids' dark rims.\n    float rim = (1.0 - inEye) * (step(up - 0.7, p.y) * step(p.y, lo + 0.7)) * step(abs(p.x), W);\n    col = mix(col, vec3(0.0), rim);\n    if (inEye > 0.5) {\n        vec2 ic = EC + vec2(1.4 * look, 0.2);\n        vec2 d = p - ic;\n        float r = length(d) / 3.2;\n        float ang = atan(d.y, d.x);\n        float streak = vnoise(vec2(ang * 4.0, 1.5 * r + 2.0 * t));\n        vec3 iris = mix(vec3(1.0, 0.9, 0.15), vec3(1.0, 0.5, 0.0), smoothstep(0.15, 0.7, r + 0.25 * streak));\n        iris = mix(iris, vec3(0.9, 0.12, 0.0), smoothstep(0.8, 1.05, r));\n        iris *= 0.85 + 0.15 * sin(TAU * 2.0 * t);\n        // The slit: tall and narrow, wider when the eye dilates.\n        float sy = d.y / 3.4;\n        float slit = abs(d.x) - pw * sqrt(max(1.0 - sy * sy, 0.0));\n        iris = mix(iris, vec3(0.0), inside(slit));\n        // A white glint on the cornea.\n        iris = mix(iris, vec3(1.0), inside(length(p - (ic + vec2(-1.6, -0.9))) - 0.35));\n        col = iris;\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  },
  {
   "name": "Eye only",
   "visible": false,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Dragon's eye: a fiery iris with a slit pupil in green scales; it looks left and right, the pupil\n// widens and narrows, a glint of light runs over the scales, and once a loop it blinks.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nconst vec2 EC = vec2(0.0, -2.4);    // centre of the eye\nconst float W = 6.4;                // half its length\nconst bool SCALES = false;           // false: the eye alone on black\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float t = iPhase;\n\n    float look = -smoothstep(0.12, 0.2, t) + 2.0 * smoothstep(0.42, 0.5, t) - smoothstep(0.72, 0.8, t);\n    float pw = 0.7 + 0.9 * (smoothstep(0.54, 0.6, t) - smoothstep(0.66, 0.74, t));\n    float open = 1.0 - (smoothstep(0.88, 0.9, t) - smoothstep(0.915, 0.94, t));\n\n    // Scales: every LED one scale, a little lighter or darker; a glint sweeps across once a loop.\n    float h = hash(led.xy * 3.1 + 7.0);\n    vec3 col = vec3(0.0, 0.42, 0.16) * (0.55 + 0.6 * h);\n    float sweep = fract(t + 0.3) * 26.0 - 13.0;\n    col += vec3(0.5, 0.9, 0.3) * exp(-pow(p.x + 0.6 * p.y - sweep, 2.0) / 1.2) * (0.3 + 0.7 * h);\n    // A brow ridge of bigger, brighter scales over the eye.\n    float browY = EC.y - 3.3 - 0.0 * p.x;\n    if (abs(p.y - (browY + 0.06 * p.x * p.x)) < 0.45 && abs(p.x) < 6.5)\n        col = vec3(0.15, 0.75, 0.25) * (0.75 + 0.35 * h);\n    if (!SCALES)\n        col = vec3(0.0);\n\n    // The opening between the lids.\n    float f = clamp(1.0 - (p.x / W) * (p.x / W), 0.0, 1.0);\n    float up = EC.y - 2.7 * pow(f, 0.7) * open;\n    float lo = EC.y + 2.1 * pow(f, 0.7) * open;\n    float inEye = step(up, p.y) * step(p.y, lo) * step(0.05, open);\n    // The lids' dark rims.\n    float rim = (1.0 - inEye) * (step(up - 0.7, p.y) * step(p.y, lo + 0.7)) * step(abs(p.x), W);\n    col = mix(col, vec3(0.0), rim);\n    if (inEye > 0.5) {\n        vec2 ic = EC + vec2(1.4 * look, 0.2);\n        vec2 d = p - ic;\n        float r = length(d) / 3.2;\n        float ang = atan(d.y, d.x);\n        float streak = vnoise(vec2(ang * 4.0, 1.5 * r + 2.0 * t));\n        vec3 iris = mix(vec3(1.0, 0.9, 0.15), vec3(1.0, 0.5, 0.0), smoothstep(0.15, 0.7, r + 0.25 * streak));\n        iris = mix(iris, vec3(0.9, 0.12, 0.0), smoothstep(0.8, 1.05, r));\n        iris *= 0.85 + 0.15 * sin(TAU * 2.0 * t);\n        // The slit: tall and narrow, wider when the eye dilates.\n        float sy = d.y / 3.4;\n        float slit = abs(d.x) - pw * sqrt(max(1.0 - sy * sy, 0.0));\n        iris = mix(iris, vec3(0.0), inside(slit));\n        // A white glint on the cornea.\n        iris = mix(iris, vec3(1.0), inside(length(p - (ic + vec2(-1.6, -0.9))) - 0.35));\n        col = iris;\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
