{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Koi pond",
   "ru": "Пруд с карпами"
  },
  "description": {
   "en": "Two koi swimming in circles under lily pads.",
   "ru": "Два карпа кои плавают по кругу под кувшинками."
  },
  "cover": 0.15,
  "tags": [
   "koi",
   "fish",
   "pond",
   "карп",
   "рыба",
   "пруд"
  ],
  "order": 110
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Koi pond",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Koi pond: an orange and a white koi chase each other round the pond once a loop, wiggling, passing\n// under lily pads; light ripples spread on the dark water. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nconst vec2 C = vec2(0.0, -1.9);     // centre of the circle the koi swim\nconst float R = 3.5;\nconst float L = 4.4;                // body length behind the nose\n\n// Like inside(), with a full LED of ramp: moving fish glide instead of stepping.\nfloat soft(float sd) { return clamp(0.5 - sd, 0.0, 1.0); }\n\n// A koi on the circle with its nose at angle a, swimming clockwise: colour in rgb, coverage in a.\n// It is base-coloured with one patch from patchAt to patchAt + 1.4 behind the nose.\nvec4 koi(vec2 p, float a, vec3 base, vec3 patch, float patchAt)\n{\n    vec2 d = p - C;\n    float u = mod(a - atan(d.y, d.x), TAU) * R - 0.3;  // distance behind the nose along the circle\n    if (u < -0.6 || u > L + 1.8)\n        return vec4(0.0);\n    float wig = 0.3 * sin(1.2 * u - TAU * 8.0 * iPhase + patchAt) * smoothstep(0.5, 3.5, u);\n    float across = length(d) - R - wig;\n    float w = u < 1.3 ? 1.35 * sqrt(clamp((u + 0.6) / 1.9, 0.0, 1.0)) : mix(1.35, 0.4, (u - 1.3) / (L - 1.3));\n    float body = u < L ? soft(abs(across) - w) : 0.0;\n    // Tail fin: a fan behind the body, flicking further than the body wiggles.\n    float tu = u - L;\n    float fan = tu > 0.0 ? soft(abs(across - 0.3 * sin(TAU * 8.0 * iPhase + patchAt)) - (0.4 + 0.6 * tu / 1.8))\n                         * (1.0 - smoothstep(1.0, 1.8, tu)) : 0.0;\n    float m = max(body, fan * 0.8);\n    vec3 c = u > patchAt && u < patchAt + 1.4 ? patch : base;\n    if (tu > 0.0)\n        c = mix(base, vec3(1.0), 0.35);\n    return vec4(c, m);\n}\n\nfloat pad(vec2 p, vec2 c, float r, float notch)\n{\n    vec2 d = p - c;\n    float cut = abs(atan(d.y, d.x) - notch) < 0.45 ? 1.0 : 0.0;\n    return inside(length(d) - r) * (1.0 - cut);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n\n    // Dark green-blue water with slow light patterns.\n    float n = vnoise(p * 0.45 + vec2(2.0 * cos(TAU * iPhase), 2.0 * sin(TAU * iPhase)));\n    vec3 col = vec3(0.0, 0.10, 0.16) + vec3(0.0, 0.10, 0.10) * smoothstep(0.55, 0.9, n);\n\n    // Ripple rings, two drops a loop.\n    for (int k = 0; k < 2; k++) {\n        float t = fract(iPhase * 2.0 + float(k) * 0.5);\n        vec2 c = k == 0 ? vec2(-4.2, -3.6) : vec2(3.0, 1.2);\n        float rr = 0.5 + 5.0 * t;\n        float ring = exp(-pow(length(p - c) - rr, 2.0) / 0.25) * (1.0 - t);\n        col += vec3(0.25, 0.45, 0.5) * ring;\n    }\n\n    float a = TAU * iPhase;\n    // An orange koi with a white saddle, and a white one with the red cap on its head.\n    vec4 f1 = koi(p, a, vec3(1.0, 0.35, 0.0), vec3(1.0), 1.8);\n    vec4 f2 = koi(p, a + 3.14159, vec3(1.0), vec3(1.0, 0.06, 0.0), 0.0);\n    col = mix(col, f1.rgb, f1.a);\n    col = mix(col, f2.rgb, f2.a);\n\n    // Lily pads float over everything; one has a pink flower.\n    float lp = max(pad(p, vec2(-5.7, -5.4), 1.6, 0.6), max(pad(p, vec2(5.6, -3.4), 1.4, 2.4),\n                                                            pad(p, vec2(0.0, 5.2), 1.3, -1.6)));\n    col = mix(col, vec3(0.05, 0.55, 0.08), lp);\n    float flower = inside(length(p - vec2(5.5, -3.5)) - 0.7);\n    col = mix(col, vec3(1.0, 0.35, 0.65), flower);\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
