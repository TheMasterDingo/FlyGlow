{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Penguin",
   "ru": "Пингвин"
  },
  "description": {
   "en": "A penguin chick waddling in the snow.",
   "ru": "Пингвинёнок переваливается под снегом."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Sky colour",
     "ru": "Цвет неба"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#0a3aa0"
   },
   {
    "type": "toggle",
    "label": {
     "en": "Snow",
     "ru": "Снег"
    },
    "targets": [
     {
      "layer": 1
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "penguin",
   "bird",
   "winter",
   "snow",
   "пингвин",
   "зима"
  ],
  "order": 50
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Ice sky",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "gradient",
    "params": {
     "gradient": [
      {
       "pos": 0.0,
       "color": "#2a7ae0"
      },
      {
       "pos": 0.5,
       "color": "#0a3aa0"
      },
      {
       "pos": 1.0,
       "color": "#06206a"
      }
     ],
     "angle": 90.0,
     "scale": 1.0,
     "mode": 0,
     "cycles": 0
    }
   }
  },
  {
   "name": "Snow",
   "visible": true,
   "opacity": 0.8,
   "blend": 2,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Snowfall: soft flakes drift down and sway; each falls a whole number of times per loop.\n// Black between the flakes, so set the layer to Screen. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float v = 0.0;\n    for (int k = 0; k < 14; k++) {\n        float fk = float(k);\n        float speed = 1.0 + floor(hash(vec2(fk, 2.0)) * 2.0);            // falls per loop: 1 or 2\n        float x0 = -7.0 + 14.0 * (fk + 0.5) / 14.0 + (hash(vec2(fk, 3.0)) - 0.5) * 0.8;\n        float y = mix(-8.0, 8.0, fract(iPhase * speed + hash(vec2(fk, 4.0))));\n        float x = x0 + 0.6 * sin(TAU * (2.0 * iPhase + hash(vec2(fk, 5.0))));\n        float d = length(p - vec2(x, y));\n        v = max(v, clamp(1.4 - 2.2 * d, 0.0, 1.0) * (0.8 + 0.2 * hash(vec2(fk, 6.0))));\n    }\n    fragColor = vec4(v * vec3(0.92, 0.96, 1.0) * ledCore(q, led), 1.0);\n}\n"
   }
  },
