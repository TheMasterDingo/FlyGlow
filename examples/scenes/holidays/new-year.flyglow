{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "New Year",
   "ru": "Новый год"
  },
  "description": {
   "en": "A garland with running lights over a snowy night.",
   "ru": "Гирлянда с бегущими огнями над снежной ночью."
  },
  "controls": [
   {
    "type": "toggle",
    "label": {
     "en": "Snowfall",
     "ru": "Снегопад"
    },
    "targets": [
     {
      "layer": 1
     }
    ]
   },
   {
    "type": "toggle",
    "label": {
     "en": "Snowdrift",
     "ru": "Сугроб"
    },
    "targets": [
     {
      "layer": 2
     }
    ]
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 3,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "new year",
