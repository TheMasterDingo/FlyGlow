{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Fireworks",
   "ru": "Салют"
  },
  "description": {
   "en": "Fireworks bursting in different colours.",
   "ru": "Разноцветный салют."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colours",
     "ru": "Цвета"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff1420"
   }
  ],
  "cover": 0.5,
  "tags": [
   "fireworks",
   "salute",
   "celebration",
   "party",
   "салют",
   "фейерверк",
   "праздник"
  ],
  "order": 15
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Fireworks",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Fireworks: four shells a loop rise from the tip of the dock on a spark trail and burst into rings of\n// coloured stars that spread, sag under gravity, crackle white and fade. Loops through iPhase: keep\n// \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst int SHELLS = 4;\nconst float RISE = 0.11;         // share of the loop a shell climbs\nconst float LIFE = 0.36;         // share of the loop a burst glows\n\nvec3 shellColor(int k)\n{\n    if (k == 0) return vec3(1.0, 0.08, 0.12);\n    if (k == 1) return vec3(0.15, 1.0, 0.25);\n    if (k == 2) return vec3(1.0, 0.7, 0.05);\n    return vec3(0.55, 0.2, 1.0);\n}\n\nfloat dot2(vec2 v) { return dot(v, v); }\n\n// Distance from p to the segment a-b.\nfloat segment(vec2 p, vec2 a, vec2 b)\n{\n    vec2 pa = p - a, ba = b - a;\n    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-5), 0.0, 1.0);\n    return length(pa - ba * h);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    vec3 col = vec3(0.0);\n    for (int k = 0; k < SHELLS; k++) {\n        float fk = float(k);\n        float t0 = (fk + 0.15 * hash(vec2(fk, 1.0))) / float(SHELLS);\n        float t = fract(iPhase - t0);                        // time since launch, wraps with the loop\n        // Burst points spread over the wide top, a little different every shell.\n        vec2 burst = vec2((k == 0 ? -3.0 : (k == 1 ? 2.8 : (k == 2 ? 0.3 : -1.0))) + 0.8 * (hash(vec2(fk, 2.0)) - 0.5),\n                          mix(-4.6, -2.8, hash(vec2(fk, 3.0))));\n        vec3 c = shellColor(k);\n        if (t < RISE) {\n            // The climb: a gold spark with a short trail, easing out at the top.\n            float u = t / RISE;\n            float e = 1.0 - (1.0 - u) * (1.0 - u);\n            vec2 start = vec2(0.0, 6.6);\n            vec2 head = mix(start, burst, e);\n            vec2 tail = mix(start, burst, max(e - 0.3, 0.0));\n            float d = segment(p, tail, head);\n            float along = clamp(dot(p - tail, head - tail) / max(dot(head - tail, head - tail), 1e-4), 0.0, 1.0);\n            col = max(col, vec3(1.0, 0.4, 0.02) * clamp(1.2 - 2.0 * d, 0.0, 1.0) * mix(0.4, 1.0, along));\n            col = max(col, vec3(1.0, 0.9, 0.6) * clamp(1.4 - 2.2 * length(p - head), 0.0, 1.0));\n        } else {\n            float u = (t - RISE) / LIFE;                     // 0..1 through the burst\n            if (u < 1.0) {\n                float R = 4.2 + 0.8 * hash(vec2(fk, 4.0));\n                float sag = 2.0;\n                // Stays bright, then dies quickly: long dim tails would read murky.\n                float fade = 1.0 - smoothstep(0.55, 1.0, u);\n                float back = max(u - 0.1, 0.0);\n                float r1 = (1.0 - exp(-4.5 * u)) / (1.0 - exp(-4.5));\n                float r0 = (1.0 - exp(-4.5 * back)) / (1.0 - exp(-4.5));\n                const int STARS = 14;\n                for (int i = 0; i < STARS; i++) {\n                    float a = TAU * (float(i) + 0.3 * hash(vec2(fk, float(i)))) / float(STARS);\n                    vec2 dir = vec2(cos(a), sin(a));\n                    // Each star is a bright head with a short dimmer trail; an inner ring follows the outer one.\n                    for (int j = 0; j < 2; j++) {\n                        float rr = j == 0 ? R : 0.5 * R;\n                        vec2 s1 = burst + dir * rr * r1 + vec2(0.0, sag * u * u);\n                        vec2 s0 = burst + dir * rr * r0 + vec2(0.0, sag * back * back);\n                        float trail = clamp(1.1 - 2.0 * segment(p, s0, s1), 0.0, 1.0) * 0.55;\n                        float head = clamp(1.4 - 2.2 * length(p - s1), 0.0, 1.0);\n                        float lv = max(trail, head) * fade;\n                        // Late crackle: some heads flash white before they die.\n                        float crackle = step(0.45, u) * step(0.6, hash(vec2(float(i) + 13.0 * fk + 50.0 * float(j),\n                                                                             floor(u * 10.0))));\n                        col = max(col, c * lv);\n                        col = max(col, mix(c, vec3(1.0), 0.7) * step(0.5, head) * crackle\n                                           * (1.0 - smoothstep(0.8, 1.0, u)));\n                    }\n                }\n                // The flash of the burst.\n                col = max(col, mix(c, vec3(1.0), 0.6) * exp(-dot2(p - burst) / 2.0) * exp(-u * 14.0));\n            }\n        }\n    }\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
