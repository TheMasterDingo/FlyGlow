{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Snowman",
   "ru": "Снеговик"
  },
  "description": {
   "en": "A snowman in falling snow.",
   "ru": "Снеговик под снегом."
  },
  "controls": [
