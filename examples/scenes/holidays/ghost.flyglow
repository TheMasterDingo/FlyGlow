{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Ghost",
   "ru": "Привидение"
  },
  "description": {
   "en": "A Halloween ghost with bats flying past.",
   "ru": "Привидение на Хэллоуин, пролетают летучие мыши."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Sky colour",
     "ru": "Цвет неба"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#6610bf"
   }
  ],
  "cover": 0.1,
  "tags": [
   "halloween",
   "ghost",
   "bats",
   "boo",
   "хэллоуин",
   "призрак",
   "привидение"
  ],
  "order": 70
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Ghost and bats",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Ghost: a white sheet ghost bobs in a violet night, its ragged hem rippling in the narrow tip of the dock,\n// while three black bats flap across the sky in front of it. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\n// 1 inside a shape whose signed distance is sd, with a soft half-LED edge.\nfloat inside(float sd) { return clamp(0.5 - 1.6 * sd, 0.0, 1.0); }\n\nfloat sdEllipse(vec2 p, vec2 r) { return (length(p / r) - 1.0) * min(r.x, r.y); }\n\n// The ghost's coverage at p (centred on its head).\nfloat ghost(vec2 p)\n{\n    float head = sdEllipse(p, vec2(2.9, 2.7));\n    // Below the head the sheet narrows towards the tip and ends in a rippling hem.\n    float y = p.y;\n    float half_w = 2.9 - 0.25 * max(y, 0.0);\n    float hem = 6.2 + 0.5 * sin(p.x * 2.4 - TAU * 2.0 * iPhase);\n    float body = max(abs(p.x) - half_w, max(-y, y - hem));\n    return inside(min(head, body));\n}\n\n// Eyes and mouth with a crisp edge, so they stay black while the ghost bobs.\nfloat face(vec2 p)\n{\n    float eyes = min(sdEllipse(p - vec2(-1.15, -0.4), vec2(0.8, 1.05)), sdEllipse(p - vec2(1.15, -0.4), vec2(0.8, 1.05)));\n    float mouth = sdEllipse(p - vec2(0.0, 1.6), vec2(0.65, 0.8));\n    return clamp(0.5 - 3.0 * min(eyes, mouth), 0.0, 1.0);\n}\n\n// A bat at c, wingspan about 4.4: body and two wings whose tips flap up and down.\nfloat bat(vec2 p, vec2 c, float flap)\n{\n    vec2 d = p - c;\n    float body = sdEllipse(d, vec2(0.5, 0.65));\n    float ax = abs(d.x);\n    // Each wing is a band that rises or dips towards its tip.\n    float wingY = mix(-0.2, -0.2 - 1.2 * flap, smoothstep(0.3, 2.2, ax));\n    float wing = max(abs(d.y - wingY) - mix(0.55, 0.3, smoothstep(0.3, 2.2, ax)), ax - 2.2);\n    return inside(min(body, wing));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    // Violet night, fading to black downwards, and an orange full moon for the bats to cross.\n    vec3 col = vec3(0.5, 0.06, 0.95) * 0.8 * smoothstep(3.0, -4.0, p.y);\n    col = mix(col, vec3(1.0, 0.62, 0.08), inside(length(p - vec2(-4.7, -4.4)) - 1.85));\n\n    vec2 g = p - vec2(0.9, -1.9 + 0.4 * sin(TAU * iPhase));\n    float gv = ghost(g);\n    vec3 sheet = mix(vec3(0.85, 0.92, 1.0), vec3(0.55, 0.75, 1.0), smoothstep(0.0, 6.0, g.y));\n    col = mix(col, sheet, gv);\n    col = mix(col, vec3(0.0), face(g) * gv);\n\n    // Bats crossing right to left, each once or twice a loop, bobbing as they flap.\n    for (int k = 0; k < 3; k++) {\n        float fk = float(k);\n        float laps = k == 1 ? 2.0 : 1.0;\n        float u = fract(iPhase * laps + 0.37 * fk);\n        float flap = sin(TAU * (12.0 * iPhase + 0.3 * fk));\n        vec2 c = vec2(mix(10.0, -10.0, u), -5.6 + 0.9 * fk + 0.3 * sin(TAU * (2.0 * u + fk)) - 0.2 * flap);\n        col = mix(col, vec3(0.0), bat(p, c, flap));\n    }\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
