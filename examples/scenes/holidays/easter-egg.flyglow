{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Easter egg",
   "ru": "Пасхальное яйцо"
  },
  "description": {
   "en": "A painted Easter egg, turning.",
   "ru": "Расписное пасхальное яйцо вращается."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff1a80"
   },
   {
    "type": "toggle",
    "label": {
     "en": "Sparkles",
     "ru": "Искорки"
    },
    "targets": [
