{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Pulse line",
   "ru": "Кардиограмма"
  },
  "description": {
   "en": "A heart monitor line.",
   "ru": "Линия кардиограммы."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#00ffb3"
   }
  ],
  "cover": 0.4,
  "tags": [
   "minimal",
   "heart",
   "pulse",
   "monitor",
   "минимализм",
   "пульс",
   "сердце"
  ],
  "order": 90
 },
 "loopSeconds": 4.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Trace",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Pulse line: an oscilloscope heart monitor. A bright point sweeps the trace across the dock, one beat in the\n// middle, and the line it leaves fades out behind it until the next sweep redraws it. The heartbeat curve follows\n// the \"heartbeat\" scope sketch on Shadertoy (sinc pulses windowed by triangles). The sweep covers the dock and the\n// fade wraps with it, so the loop closes. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float SCALE = 5.6;        // dock units per graph unit\nconst float BASE_Y = -0.2;      // the flat line\nconst float SPAN = 22.0;        // one sweep, wider than the dock so the head enters and leaves out of sight\nconst float HALF_WIDTH = 0.4;   // half the line's width\n\nfloat sinc(float x) { return x == 0.0 ? 1.0 : sin(x) / x; }\nfloat triIsolate(float x) { return abs(-1.0 + fract(clamp(x, -0.5, 0.5)) * 2.0); }\n\nfloat heartbeat(float x)\n{\n    float prebeat = -sinc((x - 0.4) * 40.0) * 0.6 * triIsolate((x - 0.4) * 1.0);\n    float mainbeat = sinc((x - 0.5) * 60.0) * 1.2 * triIsolate((x - 0.5) * 0.7);\n    float postbeat = sinc((x - 0.85) * 15.0) * 0.5 * triIsolate((x - 0.85) * 0.6);\n    return (prebeat + mainbeat + postbeat) * triIsolate((x - 0.625) * 0.8);\n}\n\n// The trace in dock units, the main beat at x = 0.\nfloat traceY(float x)\n{\n    return BASE_Y - SCALE * 0.5 * heartbeat(mod(x / SCALE + 0.5, 1.3));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = dockPos(fragCoord);\n    float head = -9.0 + SPAN * iPhase;\n\n    // Distance to the curve: sample it round this x.\n    float closest = 1e9;\n    for (float dx = -1.2; dx <= 1.2; dx += 0.04) {\n        vec2 q = vec2(p.x + dx, traceY(p.x + dx));\n        closest = min(closest, dot(q - p, q - p));\n    }\n    float line = clamp((HALF_WIDTH + 0.35 - sqrt(closest)) / 0.35, 0.0, 1.0);\n\n    // How long ago the head passed here, 0..1 of a sweep; the trace fades with it.\n    float age = mod(head - p.x, SPAN) / SPAN;\n    float fade = pow(1.0 - age, 3.0) * 1.5;\n    vec3 col = vec3(0.0, 1.0, 0.7) * line * min(fade, 1.0);\n\n    // The head: a bright point riding the curve.\n    float r = length(p - vec2(head, traceY(head)));\n    col = max(col, mix(vec3(0.0, 1.0, 0.7), vec3(0.8, 1.0, 0.95), 0.6) * clamp((1.0 - r) / 0.5, 0.0, 1.0));\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
