{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Pac-Man chase",
   "ru": "Погоня Пакмана"
  },
  "description": {
   "en": "Pac-Man chased by a ghost.",
   "ru": "За Пакманом гонится призрак."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colours",
     "ru": "Цвета"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ffd900"
   }
  ],
  "group": "Pac-Man",
  "cover": 0.45,
  "tags": [
   "pacman",
   "pac-man",
   "ghost",
   "arcade",
   "пакман",
   "призрак",
   "аркада"
  ],
  "order": 20
 },
 "loopSeconds": 5.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Chase",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Pac-Man chomps across the dock with a ghost on his tail, once per loop.\n// Loops through iPhase: set \"Loop crossfade\" to 0.\n\nconst float TAU = 6.2831853;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n    float y = 0.12;\n    // Both are off the dock when the loop wraps round.\n    float x = mix(-0.8, 1.3, iPhase);\n    vec3 col = vec3(0.0, 0.0, 0.08);\n\n    for (int i = 0; i < 9; i++) {\n        float dx = -0.6 + 0.15 * float(i);\n        if (dx > x + 0.05 && length(uv - vec2(dx, y)) < 0.035)\n            col = vec3(1.0, 0.8, 0.6);\n    }\n\n    vec2 p = uv - vec2(x, y);\n    float mouth = 0.6 * abs(sin(4.0 * TAU * iPhase));\n    if (length(p) < 0.17 && abs(atan(p.y, p.x)) > mouth * 0.5)\n        col = vec3(1.0, 0.85, 0.0);\n\n    vec2 g = uv - vec2(x - 0.42, y);\n    float wave = 0.025 * sin(40.0 * g.x + 3.0 * TAU * iPhase);\n    bool body = (g.y > 0.0 && length(g) < 0.15) || (g.y <= 0.0 && g.y > -0.15 + wave && abs(g.x) < 0.15);\n    if (body) {\n        col = vec3(1.0, 0.3, 0.6);\n        if (length(g - vec2(-0.05, 0.03)) < 0.04 || length(g - vec2(0.06, 0.03)) < 0.04)\n            col = vec3(1.0);\n    }\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
