{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Pac-Man chase v2",
   "ru": "Погоня Пакмана v2"
  },
  "description": {
   "en": "Pac-Man and Blinky running through the tunnel.",
   "ru": "Пакман и Блинки бегут по туннелю."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colours",
     "ru": "Цвета"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ffdb00"
   }
  ],
  "group": "Pac-Man",
  "cover": 0.3,
  "tags": [
   "pacman",
   "pac-man",
   "ghost",
   "arcade",
   "пакман",
   "призрак",
   "аркада"
  ],
  "order": 21
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Chase",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Pac-Man and Blinky run through the maze's side tunnel: off the right edge and back in from the left, so one\n// of them is always on the dock. Dots lie ahead of Pac-Man, vanish in his mouth and come back behind the ghost.\n// Blue maze walls above and below the lane, a power pellet blinking in the tip. LED by LED on a black background.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst float PI2 = 6.2831853;\nconst float LANE = -3.022;   // row 4\nconst float SPAN = 18.0;     // tunnel length: the dock's width plus room for both to wrap round\n\nfloat wrapX(float x) { return mod(x + 0.5 * SPAN, SPAN) - 0.5 * SPAN; }\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float row = led.z;\n    float t = iPhase;\n    vec3 col = vec3(0.0);\n\n    if (row == 0.0 || row == 8.0)\n        col = vec3(0.10, 0.10, 0.85);\n\n    float pac = wrapX(-6.0 + SPAN * t);\n    float ghost = wrapX(pac - 6.5);\n\n    if (row == 4.0 && mod(p.x + 0.5, 2.0) < 0.1) {\n        float d = wrapX(p.x - pac);\n        if (d > 0.6 || d < -9.0)\n            col = vec3(1.0, 0.72, 0.55);\n    }\n\n    // Pac-Man, chomping six times a loop.\n    vec2 a = vec2(wrapX(p.x - pac), p.y - LANE);\n    float mouth = 0.62 * (0.5 + 0.5 * cos(PI2 * 6.0 * t));\n    if (length(a) < 2.45 && abs(atan(a.y, a.x)) > mouth)\n        col = vec3(1.0, 0.86, 0.0);\n\n    // Blinky: a dome, a rippling skirt, eyes looking ahead.\n    vec2 g = vec2(wrapX(p.x - ghost), p.y - LANE);\n    float hem = 1.55 + 0.45 * step(0.5, fract((g.x + 2.3) / 1.15 + 3.0 * t));\n    if ((g.y < 0.0 && length(g) < 2.35) || (g.y >= 0.0 && g.y < hem && abs(g.x) < 2.35)) {\n        col = vec3(1.0, 0.04, 0.02);\n        if (length(g - vec2(-0.9, -0.55)) < 0.65 || length(g - vec2(0.9, -0.55)) < 0.65)\n            col = vec3(1.0);\n        if (length(g - vec2(-0.4, -0.55)) < 0.35 || length(g - vec2(1.4, -0.55)) < 0.35)\n            col = vec3(0.10, 0.10, 0.95);\n    }\n\n    // The power pellet in the tip, blinking four times a loop.\n    if (row == 12.0 && abs(p.x) < 0.6 && fract(4.0 * t) < 0.5)\n        col = vec3(1.0, 0.72, 0.55);\n\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
