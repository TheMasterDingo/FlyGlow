{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Synthwave",
   "ru": "Синтвейв"
  },
  "description": {
   "en": "A synthwave sun over a neon grid.",
   "ru": "Солнце синтвейва над неоновой сеткой."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff1a73"
   }
  ],
  "cover": 0.0,
  "tags": [
   "synthwave",
   "retrowave",
   "outrun",
   "80s",
   "синтвейв",
   "ретровейв",
   "80-е"
  ],
  "order": 900
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Synthwave",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Synthwave sun over a scrolling grid, drawn thick enough for 162 LEDs.\n// Loops through iPhase: set \"Loop crossfade\" to 0.\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n    float horizon = 0.02;\n    vec3 col;\n    if (uv.y > horizon) {\n        float h = uv.y - horizon;\n        col = mix(vec3(0.85, 0.08, 0.45), vec3(0.12, 0.0, 0.3), clamp(h * 2.4, 0.0, 1.0));\n        vec2 s = uv - vec2(0.0, 0.19);\n        float sun = 1.0 - smoothstep(0.2, 0.23, length(s));\n        // The cut-outs slide down two band heights per loop.\n        float bands = step(0.45, fract(s.y * 7.0 + 2.0 * iPhase));\n        sun *= s.y > 0.03 ? 1.0 : bands;\n        vec3 sunCol = mix(vec3(1.0, 0.1, 0.35), vec3(1.0, 0.8, 0.15), clamp(s.y * 2.5 + 0.5, 0.0, 1.0));\n        col = mix(col, sunCol, sun);\n    } else {\n        float depth = 0.25 / (horizon - uv.y + 0.03);\n        vec2 grid = vec2(uv.x * depth, depth + 2.0 * iPhase);\n        vec2 dist = abs(fract(grid) - 0.5);\n        float line = max(smoothstep(0.38, 0.5, dist.x), smoothstep(0.36, 0.5, dist.y));\n        float fade = clamp((horizon - uv.y) * 4.0, 0.0, 1.0);\n        col = mix(vec3(0.08, 0.0, 0.18), vec3(1.0, 0.1, 0.6), line * fade);\n        col = mix(col, vec3(0.6, 0.05, 0.5), (1.0 - fade) * 0.6);\n    }\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
