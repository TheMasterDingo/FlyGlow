{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Cigarette",
   "ru": "Сигарета"
  },
  "description": {
   "en": "A lit cigarette with smoke rising.",
   "ru": "Зажжённая сигарета, поднимается дым."
  },
  "controls": [
   {
    "type": "toggle",
    "label": {
     "en": "Smoke",
     "ru": "Дым"
    },
    "targets": [
     {
      "layer": 0
     }
    ]
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 1,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "cover": 0.25,
  "tags": [
   "smoke",
   "cigarette",
   "дым",
   "сигарета"
  ],
  "order": 200
 },
 "loopSeconds": 4.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Smoke",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Cigarette smoke: a grey wisp rises from the ember, drifting left, swaying and widening as it climbs, with\n// puffs travelling up it. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\n\nfloat smoke(vec2 p)\n{\n    vec2 s = vec2(3.4, -0.7);                                   // just above the ember\n    float h = s.y - p.y;                                        // height above it\n    float xc = s.x - 0.34 * h + (0.2 + 0.13 * h) * sin(0.85 * h - TAU * iPhase * 2.0);\n    float w = 0.42 + 0.17 * max(h, 0.0);\n    float across = exp(-pow((p.x - xc) / w, 2.0));\n    float puffs = 0.5 + 0.5 * sin(1.3 * h - TAU * iPhase * 3.0);\n    float fade = smoothstep(-0.3, 0.5, h) * (1.0 - smoothstep(3.5, 7.0, h));\n    return across * (0.35 + 0.65 * puffs) * fade;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    float v = 0.7 * smoke(led.xy);\n    // Plain grey: a tinted grey near the dock's dark threshold leaves coloured specks.\n    vec3 col = vec3(v * step(0.12, v));\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  },
