 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Black hole",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Black hole: a glowing accretion disc seen almost edge-on swirls round a black horizon; light from the far\n// side of the disc bends over the top and under the bottom into a halo, a thin photon ring hugs the horizon,\n// and the side of the disc spinning towards us is brighter. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\nconst vec2 C = vec2(0.0, -2.3);\nconst float RH = 2.0;          // black horizon radius\nconst float TILT = 0.18;         // the disc looks this flat: minor over major axis\nconst float R_IN = 2.4;\nconst float R_OUT = 7.5;\n\n// Swirling texture at disc radius rho and azimuth phi: the inner disc turns twice a loop, the outer once.\nfloat swirl(float rho, float phi)\n{\n    float a1 = phi - TAU * iPhase, a2 = phi - 2.0 * TAU * iPhase;\n    float n1 = fbm3(vec3(cos(a1) * 2.0, sin(a1) * 2.0, rho * 0.9));\n    float n2 = fbm3(vec3(cos(a2) * 2.0, sin(a2) * 2.0, rho * 0.9 + 7.0));\n    return mix(n2, n1, smoothstep(2.5, 6.0, rho));\n}\n\n// Hot white inside, gold, then deep orange-red at the rim.\nvec3 heatColor(float heat)\n{\n    vec3 c = mix(vec3(0.55, 0.06, 0.0), vec3(1.0, 0.55, 0.12), smoothstep(0.0, 0.5, heat));\n    return mix(c, vec3(1.0, 0.95, 0.82), smoothstep(0.6, 1.0, heat));\n}\n\nvec3 disc(float rho, float phi)\n{\n    if (rho < R_IN || rho > R_OUT)\n        return vec3(0.0);\n    float heat = clamp(1.2 - (rho - R_IN) / 4.2, 0.0, 1.0);\n    float bright = (0.4 + 0.8 * swirl(rho, phi)) * smoothstep(R_OUT, 5.5, rho) * smoothstep(R_IN, R_IN + 0.4, rho);\n    // Doppler beaming: the left side comes towards us and is brighter, the right side recedes.\n    bright *= 1.0 - 0.45 * cos(phi);\n    return heatColor(heat) * bright;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 d = led.xy - C;\n    float r = length(d);\n\n    // Where on the tilted disc this point lies: un-squash y.\n    vec2 dp = vec2(d.x, d.y / TILT);\n    float rho = length(dp);\n    float phi = atan(dp.y, dp.x);\n    vec3 discCol = disc(rho, phi);\n\n    vec3 col = vec3(0.0);\n    // The far half of the disc (above the centre line) is hidden behind the horizon.\n    if (d.y < 0.0 && r > RH)\n        col += discCol;\n\n    // Lensed image of the far side: a halo hugging the horizon, fattest over the top and under the bottom.\n    float th = atan(d.y, d.x);\n    float halo = exp(-pow((r - (RH + 0.65)) / 0.45, 2.0)) * (0.3 + 0.7 * abs(sin(th)));\n    col += heatColor(0.75) * halo * (0.55 + 0.6 * swirl(2.6, th));\n    // Photon ring: a thin bright circle right at the horizon.\n    col += vec3(1.0, 0.9, 0.75) * 0.8 * exp(-pow((r - RH - 0.15) / 0.2, 2.0));\n\n    if (r < RH)\n        col = vec3(0.0);\n    // The near half of the disc passes in front of everything.\n    if (d.y >= 0.0)\n        col = max(col, discCol);\n\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  },
