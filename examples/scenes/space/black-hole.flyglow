{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Black hole",
   "ru": "Чёрная дыра"
  },
  "description": {
   "en": "A black hole with a glowing disc.",
   "ru": "Чёрная дыра со светящимся диском."
  },
  "controls": [
   {
