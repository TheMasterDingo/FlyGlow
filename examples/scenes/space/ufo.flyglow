  {
   "name": "Beam and lights",
   "visible": true,
   "opacity": 1.0,
   "blend": 4,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// UFO beam: a green tractor beam shines from the saucer's belly down into the tip of the dock, with rings of\n// light rising up it and motes drifting into the saucer; the lights round the rim chase. The saucer is a layer\n// below this one, drawn where this one is black: set this layer to Lighten. Loops through iPhase: keep\n// \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst float TOP = -2.2;          // the bottom of the saucer, where the beam starts\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    vec3 col = vec3(0.0);\n\n    float h = p.y - TOP;\n    if (h > 0.0) {\n        float w = 1.3 + 0.22 * h;                            // half width, widening downwards\n        float inside = smoothstep(w + 0.3, w - 0.3, abs(p.x));\n        float edge = smoothstep(0.9, 0.0, abs(abs(p.x) - w + 0.2));\n        // Rings rising: four per beam length, three passes per loop.\n        float ring = smoothstep(0.55, 1.0, cos(TAU * (h / 2.2 + 3.0 * iPhase)));\n        float lvl = 0.1 + 0.3 * edge + 0.9 * ring;\n        lvl *= smoothstep(9.0, 2.0, h) * 0.5 + 0.5;\n        col = vec3(0.1, 1.0, 0.45) * lvl * inside;\n    }\n    // Motes drifting up the beam.\n    for (int k = 0; k < 6; k++) {\n        float fk = float(k);\n        float u = fract(iPhase * (1.0 + floor(2.0 * hash(vec2(fk, 1.0)))) + hash(vec2(fk, 2.0)));\n        vec2 m = vec2((hash(vec2(fk, 3.0)) - 0.5) * 2.4 + 0.4 * sin(TAU * (2.0 * u + fk * 0.3)), mix(7.5, TOP, u));\n        col = max(col, vec3(0.8, 1.0, 0.85) * clamp(1.4 - 2.2 * length(p - m), 0.0, 1.0) * smoothstep(0.0, 0.2, u)\n                  * smoothstep(1.0, 0.85, u));\n    }\n    // Rim lights along row 4: every other LED, colours chasing round twice a loop.\n    if (abs(led.z - 4.0) < 0.1 && abs(p.x) < 6.1 && mod(p.x + 6.5, 2.0) < 0.1) {\n        float k = (p.x + 6.5) / 2.0;                         // 0 .. 6\n        float c = fract((k - 14.0 * iPhase) / 3.0);          // three colours\n        vec3 lamp = c < 0.34 ? vec3(1.0, 0.1, 0.1) : (c < 0.67 ? vec3(1.0, 0.8, 0.0) : vec3(0.1, 0.6, 1.0));\n        float blink = 0.55 + 0.45 * step(0.5, fract(k * 0.5 - 4.0 * iPhase));\n        col = lamp * blink;\n    }\n    // The emitter under the saucer pulses with the rings.\n    if (abs(led.z - 5.0) < 0.1 && abs(p.x) < 1.6)\n        col = mix(vec3(0.2, 1.0, 0.55), vec3(0.85, 1.0, 0.9), 0.5 + 0.5 * cos(TAU * 3.0 * iPhase));\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
