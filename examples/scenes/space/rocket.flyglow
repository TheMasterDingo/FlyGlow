{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Rocket",
   "ru": "Ракета"
  },
  "description": {
   "en": "A rocket flying up.",
   "ru": "Ракета летит вверх."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Rocket colour",
     "ru": "Цвет ракеты"
    },
    "targets": [
     {
      "layer": 1
     }
    ],
    "base": "#ff1a10"
   },
   {
    "type": "hue",
    "label": {
     "en": "Flame colour",
     "ru": "Цвет пламени"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff8000"
   }
  ],
  "cover": 0.3,
  "tags": [
   "rocket",
   "spaceship",
   "launch",
   "ракета",
   "космос"
  ],
  "order": 10
 },
 "loopSeconds": 4.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Plume and stars",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Rocket in flight: the exhaust plume roars out of the nozzle into the tip of the dock, white-hot at the\n// nozzle with bright shock diamonds running down it, while stars stream past downwards. The rocket itself is a\n// layer above this one. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst float NOZZLE = 1.45;       // y where the plume leaves the nozzle\n\n// Stars rushing down past the rocket: a field that repeats every 16 units falls `passes` times per loop.\nfloat streaks(vec2 p, float passes, float seed)\n{\n    const float H = 16.0, CELL = 2.0;\n    float y = p.y - passes * H * iPhase;\n    float cx = floor(p.x / CELL);\n    float v = 0.0;\n    for (int k = 0; k < 2; k++) {\n        float cy = floor(y / CELL) - float(k);\n        float cyw = mod(cy, H / CELL);\n        vec2 h = vec2(hash(vec2(cx + seed, cyw)), hash(vec2(cx + 7.0, cyw + seed)));\n        if (h.x > 0.3)\n            continue;\n        vec2 s = vec2((cx + 0.25 + 0.5 * h.y) * CELL, (cy + 0.5) * CELL);\n        float dy = y - s.y;                                  // < 0 above the star: its trail\n        float along = smoothstep(-2.2, 0.0, dy) * step(dy, 0.35);\n        v = max(v, along * step(abs(p.x - s.x), 0.55) * (0.45 + 0.55 * h.y));\n    }\n    return v;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float a = TAU * iPhase;\n    vec3 col = vec3(0.7, 0.82, 1.0) * max(streaks(p, 3.0, 0.0), 0.6 * streaks(p + vec2(1.0, 0.0), 2.0, 31.0));\n\n    // The plume: widens a little below the nozzle and flickers in length and width.\n    float h = p.y - NOZZLE;                                  // distance below the nozzle\n    if (h > -0.2) {\n        float len = 5.0 + 0.5 * sin(a * 7.0) + 0.3 * sin(a * 13.0 + 1.0);\n        float w = 0.9 + 0.35 * h + 0.15 * sin(a * 11.0 + h * 2.0);\n        float across = abs(p.x + 0.12 * h * sin(a * 5.0)) / w;\n        float body = smoothstep(1.0, 0.55, across) * smoothstep(len + 0.5, len - 1.5, h);\n        float heat = clamp(1.15 - h / len - 0.6 * across, 0.0, 1.0);\n        // Shock diamonds: bright bands running down the plume.\n        heat += 0.25 * smoothstep(0.6, 1.0, cos(2.4 * h - a * 9.0)) * smoothstep(3.5, 0.5, h);\n        vec3 fire = mix(vec3(0.85, 0.08, 0.0), vec3(1.0, 0.5, 0.0), smoothstep(0.1, 0.45, heat));\n        fire = mix(fire, vec3(1.0, 0.9, 0.55), smoothstep(0.55, 0.85, heat));\n        fire = mix(fire, vec3(1.0), smoothstep(0.92, 1.1, heat));\n        col = mix(col, fire, body);\n    }\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  },
  {
