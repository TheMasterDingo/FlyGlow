{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Solar eclipse",
   "ru": "Солнечное затмение"
  },
  "description": {
   "en": "A solar eclipse.",
   "ru": "Солнечное затмение."
  },
  "cover": 0.5,
  "tags": [
   "sun",
   "moon",
   "eclipse",
   "corona",
   "солнце",
   "луна"
  ],
  "order": 70
 },
 "loopSeconds": 12.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Eclipse",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Total solar eclipse: the Moon slides across the Sun in a blue sky; the sky darkens, a diamond ring flashes,\n// then the pearly corona with pink prominences and the stars come out; another flash and the day returns.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst vec2 C = vec2(0.0, -2.4);  // the Sun\nconst float RS = 2.9;            // Sun radius\nconst float RM = 3.15;           // Moon radius: a little larger, so the eclipse is total\nconst float PI = 3.1415927;\n\n// Area two circles share, their centres d apart.\nfloat overlap(float d, float r1, float r2)\n{\n    if (d >= r1 + r2)\n        return 0.0;\n    if (d <= abs(r2 - r1))\n        return PI * min(r1, r2) * min(r1, r2);\n    float a = r1 * r1 * acos(clamp((d * d + r1 * r1 - r2 * r2) / (2.0 * d * r1), -1.0, 1.0));\n    float b = r2 * r2 * acos(clamp((d * d + r2 * r2 - r1 * r1) / (2.0 * d * r2), -1.0, 1.0));\n    float c = 0.5 * sqrt(max((-d + r1 + r2) * (d + r1 - r2) * (d - r1 + r2) * (d + r1 + r2), 0.0));\n    return a + b - c;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    // The Moon lingers in front of the Sun: x runs fast at the ends of the loop, slowly in the middle.\n    float u = 2.0 * iPhase - 1.0;\n    vec2 M = C + vec2(9.5 * sign(u) * pow(abs(u), 2.6), 0.25 * u);\n    float dm = length(p - M), ds = length(p - C);\n    float sep = length(M - C);\n    float total = smoothstep(RM - RS + 0.35, RM - RS, sep);   // totality\n    float light = 1.0 - overlap(sep, RS, RM) / (PI * RS * RS); // share of the Sun still showing\n\n    // Day sky, darkening to night only near totality.\n    vec3 col = vec3(0.04, 0.28, 1.0) * 0.5 * smoothstep(0.0, 0.35, light);\n    col = max(col, vec3(1.0) * starAt(led, 0.1, 2.0) * total);\n\n    // Corona: streamers round the Moon, white at the limb and blue further out, only when the Sun is hidden.\n    float ang = atan(p.y - C.y, p.x - C.x);\n    float a = TAU * iPhase;\n    float streak = noise3(vec3(cos(ang) * 2.5 + 0.4 * cos(a), sin(ang) * 2.5 + 0.4 * sin(a), 0.3 * ds));\n    float corona = exp(-(ds - RS) / (0.5 + 1.0 * streak)) * (0.8 + 1.0 * streak);\n    vec3 cc = mix(vec3(1.0, 0.95, 0.85), vec3(0.3, 0.55, 1.0), smoothstep(RS + 0.4, RS + 1.8, ds));\n    col = max(col, cc * corona * total * step(RM, dm));\n    // Prominences: pink flames on the limb.\n    float prom = 0.0;\n    for (int k = 0; k < 3; k++) {\n        float a0 = 0.8 + 2.1 * float(k);\n        float da = abs(mod(ang - a0 + 3.1416, TAU) - 3.1416);\n        prom = max(prom, smoothstep(0.45, 0.1, da) * smoothstep(RS + 1.2, RS + 0.5, ds));\n    }\n    col = mix(col, vec3(1.0, 0.05, 0.3), prom * total * step(RM - 0.15, dm));\n\n    // The Sun where the Moon does not cover it.\n    if (ds < RS && dm > RM) {\n        float limb = ds / RS;\n        col = mix(vec3(1.0, 0.85, 0.45), vec3(1.0, 0.5, 0.05), limb * limb);\n    } else if (dm < RM) {\n        col = min(col, vec3(0.0));\n        if (ds < RS)\n            col = vec3(0.0);\n    }\n    // Diamond ring: the last bead of sunlight flares just before and after totality.\n    vec2 bead = C + normalize(C - M + vec2(1e-4, 0.0)) * RS;\n    float ring = exp(-pow((sep - (RM - RS + 0.45)) / 0.18, 2.0));\n    col += vec3(1.0, 0.95, 0.85) * ring * exp(-dot(p - bead, p - bead) / 0.9);\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
