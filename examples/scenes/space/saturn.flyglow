  {
   "name": "Saturn",
   "visible": true,
   "opacity": 1.0,
   "blend": 4,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Saturn: a banded gold globe inside its tilted rings. The near side of the rings crosses in front of the\n// globe, the far side hides behind it; storms drift along the belts, clumps circle in the rings and a small\n// moon orbits once a loop. Black sky, for a star layer under it. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst vec2 C = vec2(0.0, -2.7);\nconst float R = 3.0;           // globe radius\nconst float TILT = 0.32;     // the rings look this flat: minor over major axis\nconst float ANG = -0.14;       // the whole system turned on the sky, radians\nconst float RI = 4.25;         // rings, inner and outer radius\nconst float RO = 7.4;\n\nvec3 globe(vec2 d)\n{\n    vec2 n2 = d / R;\n    float z = sqrt(max(1.0 - dot(n2, n2), 0.0));\n    float lat = asin(clamp(n2.y, -1.0, 1.0));\n    float a = atan(n2.x, z) - TAU * iPhase;                  // the globe turns once a loop\n    float storm = noise3(vec3(cos(a) * 1.6, sin(a) * 1.6, lat * 5.0));\n    float f = abs(lat) + 0.22 * (storm - 0.5);\n    // A pale equatorial zone, amber belts, gold zones, dull orange poles.\n    vec3 col = vec3(1.0, 0.62, 0.12);\n    col = mix(col, vec3(0.9, 0.26, 0.0), smoothstep(0.2, 0.3, f));\n    col = mix(col, vec3(1.0, 0.5, 0.06), smoothstep(0.55, 0.65, f));\n    col = mix(col, vec3(0.7, 0.2, 0.0), smoothstep(0.92, 1.02, f));\n    // Lit from the upper left.\n    float lit = clamp(dot(vec3(n2, z), normalize(vec3(-0.45, -0.4, 0.8))), 0.0, 1.0);\n    return col * (0.3 + 0.8 * lit);\n}\n\n// Ring colour; .a is 0 off the rings.\nvec4 rings(vec2 d)\n{\n    vec2 pl = vec2(d.x, d.y / TILT);\n    float rho = length(pl);\n    if (rho < RI || rho > RO)\n        return vec4(0.0);\n    float u = (rho - RI) / (RO - RI);\n    float phi = atan(pl.y, pl.x);\n    // Clumps: the inner rings go round twice a loop, the outer ones once.\n    float a1 = phi - TAU * iPhase, a2 = phi - 2.0 * TAU * iPhase;\n    float c1 = noise3(vec3(cos(a1) * 2.2, sin(a1) * 2.2, rho * 1.4));\n    float c2 = noise3(vec3(cos(a2) * 2.2, sin(a2) * 2.2, rho * 1.4 + 9.0));\n    float clump = mix(c2, c1, smoothstep(0.3, 0.7, u));\n    // Dim inner ring, bright middle, a dark gap, a slightly dimmer outer ring.\n    float dens = mix(0.6, 1.0, smoothstep(0.0, 0.3, u));\n    dens *= mix(1.0, 0.75, smoothstep(0.62, 0.72, u));\n    dens *= 0.75 + 0.45 * clump;\n    // Pale cream next to the orange globe.\n    return vec4(vec3(1.0, 0.9, 0.66) * dens, 1.0);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 d = rotate(led.xy - C, -ANG);                       // ring plane horizontal\n    vec3 col = vec3(0.0);\n    bool onGlobe = length(d) < R;\n    vec4 ring = rings(d);\n    // The far half of the rings, behind the globe.\n    if (d.y < 0.0 && !onGlobe)\n        col = ring.rgb;\n    if (onGlobe) {\n        col = globe(d);\n        // The rings' shadow: a dark band on the globe just below the near side of the rings.\n        float below = d.y - RO * TILT * sqrt(max(1.0 - d.x * d.x / (RO * RO), 0.0));\n        col *= 1.0 - 0.85 * step(0.0, below) * step(below, 0.75);\n    }\n    // The near half passes in front of the globe.\n    if (d.y >= 0.0 && ring.a > 0.0)\n        col = ring.rgb;\n    // A small moon on a wide orbit in the ring plane.\n    float a = TAU * iPhase + 1.2;\n    vec2 m = vec2(8.6 * cos(a), 8.6 * TILT * sin(a));\n    col = max(col, vec3(0.85, 0.9, 1.0) * clamp(1.6 - 2.4 * length(d - m), 0.0, 1.0));\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
