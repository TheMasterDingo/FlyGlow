{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Earthrise",
   "ru": "Восход Земли"
  },
  "description": {
   "en": "The Earth turning above the Moon's horizon.",
   "ru": "Земля вращается над горизонтом Луны."
  },
  "controls": [
   {
    "type": "toggle",
    "label": {
     "en": "Stars",
     "ru": "Звёзды"
    },
    "targets": [
     {
      "layer": 1
     }
    ]
   }
  ],
  "cover": 0.25,
  "tags": [
   "earth",
   "moon",
   "planet",
   "pragmata",
   "земля",
   "луна",
   "планета"
  ],
  "order": 101
 },
 "loopSeconds": 12.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Earth and Moon",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Earth over the Moon: the Earth turns once a loop with its clouds drifting faster, lit from the upper\n// right with a thin blue rim of atmosphere; below, the curved lunar horizon with craters. The sky is left\n// black for a star layer. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\nconst vec2 EARTH_C = vec2(0.0, -3.1);\nconst float EARTH_R = 3.3;\nconst float MOON_TOP = 2.1;\nconst float MOON_CURVE = 0.09;\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// A point on the globe at latitude lat, longitude lon, as a unit vector: noise on it wraps seamlessly.\nvec3 globe(float lat, float lon) { return vec3(cos(lat) * cos(lon), sin(lat), cos(lat) * sin(lon)); }\n\nvec3 earth(vec2 p)\n{\n    vec2 d = (p - EARTH_C) / EARTH_R;\n    float r2 = dot(d, d);\n    float z = sqrt(max(1.0 - r2, 0.0));\n    vec3 n = vec3(d.x, d.y, z);                                   // y down, z towards the viewer\n    float lat = asin(clamp(-d.y, -1.0, 1.0));\n    float lon = atan(d.x, z);\n    float spin = TAU * iPhase;\n\n    float land = fbm3(globe(lat, lon + spin) * 1.6 + 3.0);\n    float cloud = fbm3(globe(lat, lon + 2.0 * spin) * 2.2 + 11.0);\n    vec3 col = vec3(0.02, 0.16, 0.62);                            // ocean\n    col = mix(col, mix(vec3(0.10, 0.50, 0.12), vec3(0.55, 0.45, 0.20), smoothstep(0.62, 0.75, land)),\n              smoothstep(0.53, 0.58, land));\n    col = mix(col, vec3(0.95), smoothstep(1.05, 1.2, abs(lat)));  // ice caps\n    col = mix(col, vec3(1.0), 0.9 * smoothstep(0.55, 0.68, cloud));\n\n    vec3 sun = normalize(vec3(0.55, -0.35, 0.75));\n    float lit = smoothstep(-0.15, 0.35, dot(n, sun));\n    return col * (0.06 + 0.94 * lit);\n}\n\nvec3 moon(vec2 p)\n{\n    // Grey regolith, lit from the right, a little brighter towards the horizon.\n    float h = p.y - (MOON_TOP + MOON_CURVE * p.x * p.x);\n    vec3 col = vec3(0.50, 0.50, 0.52) * (0.85 + 0.06 * p.x) * (1.0 - 0.06 * h);\n    // Craters, squashed by perspective: a dark floor, a bright rim on the side facing the sun.\n    vec3 craters[4] = vec3[4](vec3(-1.6, 4.0, 1.1), vec3(1.7, 3.3, 0.9), vec3(0.2, 5.7, 0.8), vec3(-2.8, 2.9, 0.6));\n    for (int i = 0; i < 4; i++) {\n        vec2 q = (p - craters[i].xy) / vec2(craters[i].z, craters[i].z * 0.6);\n        float r = length(q);\n        col = mix(col, vec3(0.22, 0.22, 0.24), 1.0 - smoothstep(0.75, 1.0, r));\n        col = mix(col, vec3(0.78, 0.78, 0.80), (1.0 - smoothstep(0.0, 0.35, abs(r - 1.0))) * smoothstep(-0.2, 0.6, -q.x));\n    }\n    return col;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    vec3 col = vec3(0.0);\n\n    float r = length(p - EARTH_C);\n    if (r <= EARTH_R + 0.2) {\n        col = earth(p);\n    } else {\n        // Atmosphere: a thin blue rim, brightest on the sunlit side.\n        vec2 d = normalize(p - EARTH_C);\n        float side = smoothstep(-0.6, 0.8, dot(d, normalize(vec2(0.55, -0.35))));\n        col = vec3(0.15, 0.5, 1.0) * 0.85 * exp(-(r - EARTH_R) * (r - EARTH_R) / 0.4) * side;\n    }\n    if (p.y >= MOON_TOP + MOON_CURVE * p.x * p.x)\n        col = moon(p);\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  },
