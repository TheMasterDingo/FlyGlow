{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Warp speed",
   "ru": "Варп-прыжок"
  },
  "description": {
   "en": "Stars streaking past at warp speed.",
   "ru": "Звёзды проносятся на варп-скорости."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#a070ff"
   }
  ],
  "cover": 0.35,
  "tags": [
   "stars",
   "hyperspace",
   "speed",
   "star wars",
   "звёзды"
  ],
  "order": 30
 },
 "loopSeconds": 4.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Warp stars",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 140.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Stars streaking out of the centre. Each star makes a whole number of trips per loop.\n// Loops through iPhase: set \"Loop crossfade\" to 0.\n\nconst float TAU = 6.2831853;\n\nfloat hash(float n)\n{\n    return fract(sin(n * 127.1) * 43758.5453);\n}\n\nfloat segment(vec2 p, vec2 a, vec2 b)\n{\n    vec2 pa = p - a, ba = b - a;\n    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);\n    return length(pa - ba * h);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y - vec2(0.0, 0.11);\n    vec3 col = vec3(0.0, 0.0, 0.03);\n    for (int i = 0; i < 36; i++) {\n        float fi = float(i);\n        float angle = TAU * hash(fi + 1.0);\n        float trips = 1.0 + floor(hash(fi + 2.0) * 2.0);\n        float z = fract(hash(fi + 3.0) + iPhase * trips);\n        vec2 dir = vec2(cos(angle), sin(angle));\n        vec2 head = dir * (0.05 + 0.75 * z * z);\n        vec2 tail = dir * (0.05 + 0.75 * z * z * 0.7);\n        float d = segment(uv, tail, head);\n        float width = 0.035 + 0.055 * z;\n        vec3 tint = mix(vec3(0.35, 0.65, 1.0), vec3(1.0, 0.45, 1.0), hash(fi + 4.0));\n        col += 1.6 * tint * smoothstep(width, 0.0, d) * smoothstep(0.0, 0.15, z);\n    }\n    fragColor = vec4(min(col, 1.0), 1.0);\n}\n"
   }
  }
 ]
}
