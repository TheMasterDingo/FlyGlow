  {
   "name": "Comet",
   "visible": true,
   "opacity": 1.0,
   "blend": 4,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Comet: a bright head in a green coma, a straight blue ion tail and a broad curved gold dust tail stream\n// away across the sky, rippling outwards. Black sky, for a star layer under it. Loops through iPhase: keep\n// \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\nconst float TAU = 6.2831853;\n\n// A sparse field of twinkling stars, one star per LED at most: density 0..1 is the share of LEDs with one;\n// each twinkles once or twice a loop.\nfloat starAt(vec3 led, float density, float seed)\n{\n    vec2 id = vec2(led.x * 2.0 + seed * 37.0, led.z + seed * 11.0);\n    if (hash(id + 0.31) > density)\n        return 0.0;\n    float rate = 1.0 + floor(hash(id + 7.7) * 2.0);\n    float tw = 0.5 + 0.5 * cos(TAU * (rate * iPhase + hash(id + 5.3)));\n    return (0.4 + 0.6 * hash(id + 9.1)) * (0.25 + 0.75 * tw * tw);\n}\n\nvec2 rotate(vec2 v, float a)\n{\n    float c = cos(a), s = sin(a);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}\n\nconst vec2 HEAD = vec2(-3.6, -4.0);\nconst vec2 T = vec2(0.87, 0.5);  // the tail points this way, away from the Sun\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float a = TAU * iPhase;\n    vec2 rel = p - HEAD;\n    vec2 N = vec2(-T.y, T.x);\n    float along = dot(rel, T);\n    float across = dot(rel, N);\n    vec3 col = vec3(0.0);\n    if (along > -0.5) {\n        float s = max(along, 0.0);\n        float fade = pow(clamp(1.0 - s / 11.0, 0.0, 1.0), 0.7);\n        // Ion tail: narrow and straight, above the dust tail; knots rush outwards.\n        float ion = exp(-pow((across + 0.1 * s) / (0.5 + 0.07 * s), 2.0));\n        ion *= (0.7 + 0.3 * cos(1.3 * s - 4.0 * a)) * fade;\n        // Dust tail: broad, curving away below, fading from white-gold to gold.\n        float c = across - 0.045 * s * s;\n        float dust = exp(-pow(c / (0.6 + 0.16 * s), 2.0)) * fade;\n        dust *= 0.75 + 0.25 * cos(0.9 * s - 2.0 * a + 1.0);\n        // Dim fringes would read murky: cut them off.\n        ion *= smoothstep(0.12, 0.3, ion);\n        dust *= smoothstep(0.12, 0.3, dust);\n        vec3 dc = mix(vec3(1.0, 0.92, 0.65), vec3(1.0, 0.62, 0.12), smoothstep(1.0, 6.0, s));\n        col = max(vec3(0.1, 0.5, 1.0) * min(ion * 1.8, 1.0), dc * min(dust * 1.7, 1.0));\n        col *= smoothstep(-0.5, 0.6, along);\n    }\n    // Coma and nucleus.\n    float r = length(rel);\n    col = max(col, vec3(0.2, 1.0, 0.45) * exp(-r * r / 2.2));\n    col = mix(col, vec3(1.0), exp(-r * r / 0.35));\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
