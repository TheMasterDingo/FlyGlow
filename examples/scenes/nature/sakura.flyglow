  ],
  "order": 40
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Evening sky",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "gradient",
    "params": {
     "gradient": [
      {
       "pos": 0.0,
       "color": "#4a34b0"
      },
      {
       "pos": 0.35,
       "color": "#22105e"
      },
      {
