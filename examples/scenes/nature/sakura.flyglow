{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Sakura",
   "ru": "Сакура"
  },
  "description": {
   "en": "A blooming sakura bending in the wind, petals falling; the trunk can be turned off.",
   "ru": "Цветущая сакура гнётся на ветру, сыплются лепестки, ствол можно выключить."
  },
  "controls": [
   {
    "type": "choice",
    "label": {
     "en": "Trunk",
     "ru": "Ствол"
    },
    "options": [
     {
      "label": {
       "en": "On",
       "ru": "Вкл"
      },
      "set": [
       {
        "layer": 2,
        "visible": true
       },
       {
        "layer": 3,
        "visible": false
       }
      ]
     },
     {
      "label": {
       "en": "Off",
       "ru": "Выкл"
      },
      "set": [
       {
        "layer": 2,
        "visible": false
       },
       {
        "layer": 3,
        "visible": true
       }
      ]
     }
    ]
   },
   {
    "type": "hue",
    "label": {
     "en": "Blossom colour",
     "ru": "Цвет лепестков"
    },
