{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Thunderstorm",
   "ru": "Гроза"
  },
  "description": {
   "en": "Rain and lightning.",
   "ru": "Дождь и молнии."
  },
  "controls": [
   {
    "type": "number",
    "label": {
     "en": "Rain",
     "ru": "Дождь"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "targets": [
     {
      "layer": 1,
      "param": "density"
     }
    ],
    "suffix": "%"
   }
  ],
  "cover": 0.17,
  "tags": [
   "storm",
   "lightning",
   "rain",
   "thunder",
   "гроза",
   "молния",
   "дождь"
  ],
  "order": 21
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Storm",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Thunderstorm: heavy clouds churn along the top; twice a loop a forked bolt strikes down into the tip\n// with a double flash that lights the clouds from inside, and once a far-off flash flickers in them.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nfloat fbm(vec2 p) { return 0.6 * vnoise(p) + 0.3 * vnoise(p * 2.1 + 7.3) + 0.1 * vnoise(p * 4.2 + 3.1); }\n\n// A double flash starting at phase t0: a bright stroke and a weaker one just after it.\nfloat flash(float t, float t0)\n{\n    float a = t - t0, b = t - t0 - 0.03;\n    return (a >= 0.0 ? exp(-a / 0.012) : 0.0) + (b >= 0.0 ? 0.8 * exp(-b / 0.016) : 0.0);\n}\n\n// 1 on the LEDs of bolt s (rows 5..15), with a fork from row 8 to row 12.\nfloat bolt(vec3 led, float s)\n{\n    float row = led.z;\n    if (row < 5.0)\n        return 0.0;\n    float x = -2.5 + 5.0 * hash(vec2(s, 1.0));\n    float xf = 0.0;\n    float hit = 0.0;\n    float dir = x > 0.0 ? -1.0 : 1.0;\n    for (int k = 5; k <= 15; k++) {\n        float fk = float(k);\n        if (k > 5)\n            x += (hash(vec2(s * 17.0, fk)) - 0.5) * 1.6 + 0.12 * dir;\n        float hw = fk <= 2.0 ? 7.5 : 7.5 - 0.5 * (fk - 2.0);\n        x = clamp(x, -hw + 0.5, hw - 0.5);\n        if (k == 8)\n            xf = x;\n        if (k > 8 && k <= 12)\n            xf += dir * 0.9 + (hash(vec2(s * 5.0, fk)) - 0.5) * 0.8;\n        if (fk == row) {\n            hit = max(hit, smoothstep(0.75, 0.3, abs(led.x - x)));\n            if (k > 8 && k <= 12)\n                hit = max(hit, 0.7 * smoothstep(0.75, 0.3, abs(led.x - xf)));\n        }\n    }\n    return hit;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float t = iPhase;\n    float f1 = flash(t, 0.16), f2 = flash(t, 0.58);\n    float far = 0.35 * flash(t, 0.84);\n    float lit = min(f1 + f2 + far, 1.4);\n\n    // Clouds: noise turning on a circle so the loop is seamless; a ragged base around row 5.\n    vec2 drift = 1.8 * vec2(cos(TAU * t), sin(TAU * t));\n    float n = fbm(p * vec2(0.32, 0.5) + drift);\n    float cloud = smoothstep(-1.4, -3.0, p.y + 2.6 * (n - 0.5));\n    vec3 col = vec3(0.0);\n    vec3 cc = mix(vec3(0.08, 0.08, 0.22), vec3(0.32, 0.34, 0.55), smoothstep(0.3, 0.75, n));\n    cc += vec3(0.65, 0.7, 1.0) * lit * (0.35 + 0.65 * n);\n    col = mix(col, cc, cloud);\n    // The whole sky glows faintly with each strike.\n    col += vec3(0.12, 0.12, 0.25) * min(f1 + f2, 1.0) * (1.0 - cloud);\n\n    // The bolts, white-violet, visible while their flash lasts.\n    float b = bolt(led, 1.0) * smoothstep(0.08, 0.3, f1) + bolt(led, 2.0) * smoothstep(0.08, 0.3, f2);\n    col = mix(col, vec3(0.9, 0.88, 1.0), clamp(b, 0.0, 1.0));\n    fragColor = vec4(min(col, vec3(1.0)) * ledCore(q, led), 1.0);\n}\n"
   }
  },
