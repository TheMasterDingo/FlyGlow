{
 "brightness": 100,
 "format": "flyglow",
 "gamepad": {
  "brightness": 50,
  "direction": "out",
  "dockRow": 0,
  "palette": [
   "#00ff78",
   "#00aaff",
   "#963cff"
  ],
  "step": 6,
  "style": "flow"
 },
 "layers": [
  {
   "blend": 0,
   "effect": {
    "params": {
     "brightness": 120,
     "panX": 0,
     "panY": 0,
     "saturation": 100,
     "seam": 0,
     "speed": 1,
     "zoom": 1
    },
    "source": "// Aquarium: a clownfish and a yellow tang cross the dock in opposite directions,\n// bubbles rise from the weed, light shimmers under the surface.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs\n// without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nfloat sdEllipse(vec2 p, vec2 r) { return (length(p / r) - 1.0) * min(r.x, r.y); }\n\n// A fish facing +x at the origin of q; returns colour in rgb and coverage in a.\nvec4 fish(vec2 q, vec2 r, vec3 body, vec3 stripe, float wag)\n{\n    float b = inside(sdEllipse(q, r));\n    // Tail: a wedge behind the body that flaps up and down.\n    vec2 t = q - vec2(-r.x - 0.2, wag);\n    float tail = inside(max(t.x - 0.4, max(-t.x - 1.3, abs(t.y) - (0.25 + 0.55 * (-t.x + 0.4) / 1.7))));\n    vec3 c = body;\n    if (stripe != vec3(0.0))\n        c = mix(c, stripe, inside(abs(q.x + 0.1) - 0.45));\n    float eye = inside(length(q - vec2(r.x * 0.55, -r.y * 0.2)) - 0.5);\n    c = mix(c, vec3(0.0), eye);\n    float a = max(b, tail);\n    return vec4(mix(body, c, b), a);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q0 = dockPos(fragCoord);\n    vec3 led = ledCell(q0);\n    vec2 p = led.xy;\n\n    // Water: light under the surface, deep blue below, a slow shimmer across the top.\n    float depth = clamp((p.y + 6.5) / 13.0, 0.0, 1.0);\n    vec3 col = mix(vec3(0.0, 0.12, 0.34), vec3(0.0, 0.035, 0.13), depth);\n    float shimmer = sin(1.1 * p.x - TAU * 2.0 * iPhase) * sin(0.7 * p.x + 0.9 * p.y + TAU * iPhase);\n    col += vec3(0.04, 0.16, 0.20) * max(shimmer, 0.0) * (1.0 - depth);\n\n    // Sand and two strands of weed swaying from the bottom tip.\n    if (p.y > 5.2)\n        col = vec3(0.55, 0.42, 0.16);\n    for (int k = 0; k < 2; k++) {\n        float bx = k == 0 ? -1.0 : 1.0;\n        float h = 6.2 - p.y;                                   // height above the sand\n        float top = k == 0 ? 6.0 : 4.8;\n        float sway = 0.7 * sin(TAU * iPhase + float(k) * 2.1 + h * 0.5) * h / top;\n        if (h > 0.0 && h < top && abs(p.x - bx - sway) < 0.55)\n            col = vec3(0.05, 0.55, 0.12);\n    }\n\n    // Bubbles rise twice a loop each, wobbling.\n    for (int k = 0; k < 4; k++) {\n        float fk = float(k);\n        float u = fract(2.0 * iPhase + fk * 0.25 + 0.1 * fk * fk);\n        vec2 bp = vec2((k < 2 ? -1.0 : 1.0) + 0.45 * sin(TAU * (3.0 * u + fk * 0.3)), mix(4.5, -8.0, u));\n        float b = inside(length(p - bp) - 0.3);\n        col = mix(col, vec3(0.75, 0.95, 1.0), b * 0.9);\n    }\n\n    // Clownfish left to right through the wide upper part, once per loop.\n    {\n        float x = mix(-11.0, 11.0, iPhase);\n        vec2 at = vec2(x, -1.4 + 0.5 * sin(TAU * 2.0 * iPhase));\n        vec4 f = fish(p - at, vec2(2.2, 1.2), vec3(1.0, 0.40, 0.0), vec3(1.0), 0.35 * sin(TAU * 12.0 * iPhase));\n        col = mix(col, f.rgb, f.a);\n    }\n    // Yellow tang right to left, half a loop later, higher up.\n    {\n        float x = mix(10.5, -10.5, fract(iPhase + 0.5));\n        vec2 at = vec2(x, -4.5 + 0.35 * sin(TAU * 3.0 * iPhase + 1.0));\n        vec2 q = p - at;\n        q.x = -q.x;\n        vec4 f = fish(q, vec2(1.8, 1.3), vec3(1.0, 0.85, 0.0), vec3(0.0), 0.3 * sin(TAU * 14.0 * iPhase));\n        col = mix(col, f.rgb, f.a);\n    }\n    fragColor = vec4(col * ledCore(q0, led), 1.0);\n}\n",
    "type": "shader"
   },
   "name": "Aquarium",
   "opacity": 1,
   "visible": true
  }
 ],
 "loopSeconds": 12,
 "outputGamma": 1.4,
 "version": 1,
 "preset": {
  "title": {
   "en": "Aquarium",
   "ru": "Аквариум"
  },
  "description": {
   "en": "Fish swimming past weed and bubbles.",
   "ru": "Рыбки плавают среди водорослей и пузырьков."
  },
