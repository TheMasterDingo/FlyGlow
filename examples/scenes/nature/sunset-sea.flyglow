{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Sunset at sea",
   "ru": "Закат над морем"
  },
  "description": {
   "en": "The sun setting into the sea.",
   "ru": "Солнце садится в море."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff4c0a"
   }
  ],
  "cover": 0.3,
  "tags": [
   "sunset",
   "sea",
   "ocean",
   "sun",
   "закат",
   "море",
   "солнце"
  ],
  "order": 10
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Sunset",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Sunset over the sea: the sun sits half sunk on the horizon under a violet and orange sky, two\n// strips of cloud drift past, waves roll towards the tip and the sun's path glitters on them.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\n// 1 inside, 0 outside, with a half-LED ramp across the edge so moving shapes glide between LEDs.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst float TAU = 6.2831853;\n\nconst float HY = -0.85;             // the horizon, between rows 6 and 7\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float t = iPhase;\n    vec3 col;\n    if (p.y < HY) {\n        float h = (HY - p.y) / 5.8;                     // 0 at the horizon, 1 at the top\n        col = mix(vec3(1.0, 0.30, 0.04), vec3(0.95, 0.06, 0.25), smoothstep(0.0, 0.5, h));\n        col = mix(col, vec3(0.30, 0.02, 0.45), smoothstep(0.45, 1.0, h));\n        // Two strips of cloud cross the sky once and twice a loop, lit pink from below.\n        for (int k = 0; k < 2; k++) {\n            float fk = float(k);\n            float cy = HY - 2.6 - 2.0 * fk;\n            float x = mod(p.x + 22.0 * t * (1.0 + fk) + 9.0 * fk, 22.0) - 11.0;\n            float strip = inside(abs(p.y - cy + 0.08 * x) - 0.35) * smoothstep(3.8, 2.2, abs(x));\n            col = mix(col, fk < 0.5 ? vec3(1.0, 0.35, 0.35) : vec3(0.55, 0.06, 0.35), strip * 0.9);\n        }\n        // The sun and its glow.\n        float d = length(p - vec2(0.0, HY + 0.3));\n        col += vec3(1.0, 0.35, 0.0) * 0.4 * exp(-max(d - 2.4, 0.0) * max(d - 2.4, 0.0) / 1.5);\n        col = mix(col, mix(vec3(1.0, 1.0, 0.75), vec3(1.0, 0.85, 0.2), smoothstep(0.8, 2.4, d)), inside(d - 2.4));\n    } else {\n        float depth = (p.y - HY) / 7.4;\n        col = mix(vec3(0.04, 0.08, 0.40), vec3(0.0, 0.02, 0.16), depth);\n        // Waves roll towards the viewer, three a loop, the crests bent a little.\n        float w = sin(2.6 * (p.y - HY) / (0.4 + depth) - TAU * 3.0 * t + 0.8 * sin(0.6 * p.x + TAU * t));\n        col += vec3(0.08, 0.14, 0.40) * smoothstep(0.5, 1.0, w);\n        // The sun's path: gold glints on the crests, widening towards the tip.\n        float hw = 0.9 + 1.4 * depth;\n        float path = smoothstep(hw, hw * 0.35, abs(p.x));\n        float g = hash(led.xy * 7.0 + floor(t * 16.0));\n        float glint = smoothstep(0.55, 0.85, w + 0.3 * (g - 0.5));\n        col = mix(col, vec3(1.0, 0.75, 0.15), smoothstep(0.3, 0.8, path) * glint);\n        // The water right under the sun is brightest.\n        col = mix(col, vec3(1.0, 0.8, 0.25), smoothstep(0.3, 0.8, path) * step(p.y - HY, 1.0));\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
