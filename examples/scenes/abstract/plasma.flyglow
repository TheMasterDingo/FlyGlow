{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Plasma",
   "ru": "Плазма"
  },
  "description": {
   "en": "Classic demo-scene plasma in blue, violet, pink and amber.",
   "ru": "Классическая плазма: синий, фиолетовый, розовый, янтарный."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#c000ff"
   },
   {
    "type": "number",
    "label": {
     "en": "Size",
     "ru": "Размер"
    },
    "min": 30,
    "max": 300,
    "step": 5,
    "targets": [
     {
      "layer": 0,
      "param": "scale",
      "from": 0.3,
      "to": 3.0
     }
    ],
    "suffix": "%"
   }
  ],
  "cover": 0.0,
  "tags": [
   "plasma",
   "demoscene",
   "retro",
   "плазма"
  ],
  "order": 70
 },
 "loopSeconds": 10.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Plasma",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "plasma",
    "params": {
     "gradient": [
      {
       "pos": 0.0,
       "color": "#000000"
      },
      {
       "pos": 0.22,
       "color": "#1a00ff"
      },
      {
       "pos": 0.45,
       "color": "#c000ff"
      },
      {
       "pos": 0.7,
       "color": "#ff0060"
      },
      {
       "pos": 1.0,
       "color": "#ffa000"
      }
     ],
     "scale": 0.8,
     "colorCycle": 0,
     "cycles": 1
    }
   }
  }
 ]
}
