{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Mandala",
   "ru": "Мандала"
  },
  "description": {
   "en": "Rings of petals turn and open around a gold centre.",
   "ru": "Кольца лепестков вращаются и раскрываются вокруг золотого центра."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff0066"
   }
  ],
  "cover": 0.55,
  "tags": [
   "mandala",
   "flower",
   "bloom",
   "мандала",
   "цветок"
  ],
  "order": 50
 },
 "loopSeconds": 10.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Mandala",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Blooming mandala: three rings of six petals round a gold heart, magenta outside, amber in the middle,\n// cyan inside, each ring turning against its neighbours. Once a loop the flower blooms: the petals grow and\n// widen from the inside out, then close again. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\n// Signed distance to the nearest of n elliptic petals of length len and half width wid that start at the\n// middle, turned by rot.\nfloat petals(vec2 d, float n, float len, float wid, float rot)\n{\n    float seg = TAU / n;\n    float k = mod(atan(d.y, d.x) - rot + 0.5 * seg, seg) - 0.5 * seg;   // angle from the nearest petal axis\n    vec2 p = length(d) * vec2(cos(k), sin(k)) - vec2(0.5 * len, 0.0);\n    vec2 ax = vec2(0.5 * len, wid);\n    return (length(p / ax) - 1.0) * min(ax.x, ax.y);\n}\n\n// How far each ring is open, 0..1: the inner ring leads, the outer follows.\nfloat bloom(float delay)\n{\n    return 0.5 - 0.5 * cos(TAU * (iPhase - delay));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 d = led.xy - MID;\n    float r = length(d);\n    float turn = TAU * iPhase / 6.0;        // a sixth of a turn per loop looks the same as none\n    vec3 col = vec3(0.0);\n\n    float o = bloom(0.16);\n    float len = mix(6.6, 9.0, o);\n    float sd = petals(d, 6.0, len, mix(1.9, 2.7, o), turn);\n    col = mix(vec3(1.0, 0.0, 0.4), vec3(1.0, 0.3, 0.7), clamp(r / len, 0.0, 1.0)) * inside(sd);\n\n    o = bloom(0.08);\n    len = mix(4.2, 5.8, o);\n    sd = petals(d, 6.0, len, mix(1.2, 1.8, o), -turn + TAU / 12.0);\n    col *= 1.0 - inside(sd - 0.8);                          // a dark rim lifts the ring off the one behind\n    col = mix(col, mix(vec3(1.0, 0.3, 0.0), vec3(1.0, 0.7, 0.05), clamp(r / len, 0.0, 1.0)), inside(sd));\n\n    o = bloom(0.0);\n    len = mix(2.3, 3.3, o);\n    sd = petals(d, 6.0, len, mix(0.7, 1.0, o), 2.0 * turn);\n    col *= 1.0 - inside(sd - 0.7);\n    col = mix(col, vec3(0.0, 0.75, 1.0), inside(sd));\n\n    col = mix(col, vec3(1.0, 0.85, 0.4), inside(r - 0.8));\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
