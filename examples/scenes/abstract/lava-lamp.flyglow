{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Lava lamp",
   "ru": "Лава-лампа"
  },
  "description": {
   "en": "Orange blobs drift and merge on purple.",
   "ru": "Оранжевые капли плавают и сливаются на фиолетовом."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#ff2e05"
   }
  ],
  "cover": 0.3,
  "tags": [
   "lava",
   "blobs",
   "retro",
   "лава"
  ],
  "order": 20
 },
 "loopSeconds": 18.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Lava lamp",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Lava-lamp blobs drifting along closed paths, so the loop has no seam.\n// Loops through iPhase: set \"Loop crossfade\" to 0.\n\nconst float TAU = 6.2831853;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n    float t = TAU * iPhase;\n    float field = 0.0;\n    for (int i = 0; i < 6; i++) {\n        float fi = float(i);\n        vec2 c = vec2(0.40 * sin(t * (1.0 + mod(fi, 2.0)) + fi * 1.7),\n                      0.30 * cos(t * (1.0 + mod(fi, 3.0)) + fi * 2.3) + 0.06);\n        float r = 0.11 + 0.035 * sin(t + fi * 1.3);\n        field += r * r / dot(uv - c, uv - c);\n    }\n    vec3 col = vec3(0.12, 0.0, 0.22);\n    col = mix(col, vec3(1.0, 0.18, 0.02), smoothstep(0.7, 1.1, field));\n    col = mix(col, vec3(1.0, 0.75, 0.15), smoothstep(1.6, 2.8, field));\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
