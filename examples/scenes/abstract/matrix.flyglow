{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Digital rain",
   "ru": "Цифровой дождь"
  },
  "description": {
   "en": "Green code runs down in columns.",
   "ru": "Зелёный код стекает колонками."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#00ff40"
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 0,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "cover": 0.67,
  "order": 100,
  "tags": [
   "matrix",
   "code",
   "rain",
   "green",
   "hacker",
   "матрица",
   "код"
  ]
 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Digital rain",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Matrix digital rain: green code columns falling top to bottom, one LED column each.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    // A column zigzags down the hex lattice: x = c on rows of odd length, c + 0.5 on the others.\n    float c = floor(led.x + 0.25);\n    vec2 p = led.xy;\n\n    vec3 col = vec3(0.0);\n    // Whole falls per loop, 3 to 5: coprime-ish speeds keep the rain from repeating within the loop.\n    float speed = 3.0 + floor(hash(vec2(c, 3.1)) * 3.0);\n    float len = 4.5 + 4.0 * hash(vec2(c, 7.7));\n    // The head runs past the bottom by a random gap, so columns rest between drops.\n    float gap = 2.0 + 12.0 * hash(vec2(c, 5.9));\n    float start = hash(vec2(c, 1.3));\n    float head = mix(-8.0, 7.5 + len + gap, fract(iPhase * speed + start));\n    float d = head - p.y;                                              // > 0 above the head: the trail\n    if (d > -0.8 && d < len) {\n        // Each code cell flickers between glyphs 20 times a loop.\n        float glyph = 0.7 + 0.3 * hash(vec2(c * 13.0 + led.z, floor(iPhase * 20.0)));\n        float trail = pow(clamp(1.0 - d / len, 0.0, 1.0), 1.5) * glyph;\n        float tip = exp(-d * d / (2.0 * 0.4 * 0.4));\n        col = vec3(0.0, 1.0, 0.25) * trail + vec3(0.7, 1.0, 0.75) * tip;\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
