{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Liquid chrome",
   "ru": "Жидкий хром"
  },
  "description": {
   "en": "Liquid metal ripples, reflecting a blue and magenta sky.",
   "ru": "Жидкий металл в ряби, отражает сине-пурпурное небо."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#0073ff"
   }
  ],
  "cover": 0.0,
  "tags": [
   "chrome",
   "metal",
   "mirror",
   "liquid",
   "хром",
   "металл"
  ],
  "order": 90
 },
 "loopSeconds": 16.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Chrome",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Liquid chrome: four drops of mirror metal swell up out of a gently rippling pool and glide round it. The\n// metal reflects a blue sky with a bright band above a black horizon and a magenta sunset below it, with\n// white glints where it catches the light; the colour depends only on which way the surface tilts, like a\n// matcap. Drops and ripples move through whole cycles per loop. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nfloat height(vec2 p)\n{\n    float T = TAU * iPhase;\n    float h = 0.30 * sin(0.55 * p.x + 0.30 * p.y + T)\n            + 0.25 * sin(-0.45 * p.x + 0.60 * p.y + T + 1.3)\n            + 0.20 * sin(0.75 * p.x - 0.55 * p.y - T + 2.1);\n    for (int i = 0; i < 4; i++) {\n        float fi = float(i);\n        vec2 c = MID + vec2(4.2 * sin(T + 1.6 * fi),\n                            2.6 * cos(T * (mod(fi, 2.0) < 0.5 ? 1.0 : -1.0) + 2.3 * fi));\n        vec2 d = p - c;\n        h += 1.6 * exp(-dot(d, d) / 3.2);\n    }\n    return h;\n}\n\n// What a mirror tilted towards n shows: sky when it faces up the dock, the sunset when it faces down.\nvec3 environment(vec3 n)\n{\n    float e = 0.25 - 1.3 * n.y;                         // elevation of the reflected ray; layout y points down\n    vec3 sky = mix(vec3(0.7, 0.95, 1.0), vec3(0.0, 0.45, 1.0), smoothstep(0.2, 0.45, e));\n    sky = mix(sky, vec3(0.0, 0.08, 0.6), smoothstep(0.7, 1.1, e));\n    vec3 ground = mix(vec3(1.0, 0.05, 0.5), vec3(0.3, 0.0, 0.55), smoothstep(-0.25, -0.6, e));\n    vec3 col = e > 0.0 ? sky : ground;\n    col *= smoothstep(0.05, 0.14, abs(e));              // the black horizon line\n    float glint = pow(max(dot(n, normalize(vec3(-0.45, -0.55, 0.7))), 0.0), 20.0);\n    return col + vec3(1.0) * glint;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = dockPos(fragCoord);\n    const float e = 0.05;\n    float h = height(p);\n    vec2 g = vec2(height(p + vec2(e, 0.0)) - h, height(p + vec2(0.0, e)) - h) / e;\n    vec3 n = normalize(vec3(-1.4 * g, 1.0));\n    fragColor = vec4(min(environment(n), vec3(1.0)), 1.0);\n}\n"
   }
  }
 ]
}
