{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Control: the Hiss v2",
   "ru": "Control: Шипение v2"
  },
  "description": {
   "en": "Control's Hiss as red fluid swirling in the dark.",
   "ru": "Шипение из Control: красная жидкость клубится в темноте."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
