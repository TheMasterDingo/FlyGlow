  {
   "name": "Falling leaves",
   "visible": true,
   "opacity": 1.0,
   "blend": 2,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Golden leaves of the Erdtree drifting down and swaying; each falls a whole number of times per loop.\n// Black between the leaves, so the layer sits in Screen mode. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border, so no light leaks into the neighbours; keeps about\n// 2/3 of the light, which brightness 120% evens out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins).\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    vec3 col = vec3(0.0);\n    for (int k = 0; k < 9; k++) {\n        float fk = float(k);\n        float speed = 1.0 + floor(hash(vec2(fk, 2.0)) * 2.0);            // falls per loop: 1 or 2\n        float x0 = -6.5 + 13.0 * (fk + 0.5) / 9.0 + (hash(vec2(fk, 3.0)) - 0.5) * 1.2;\n        float y = mix(-3.0, 8.0, fract(iPhase * speed + hash(vec2(fk, 4.0))));\n        float x = x0 * (1.0 - 0.06 * (y + 3.0)) + 0.9 * sin(TAU * (speed * iPhase + hash(vec2(fk, 5.0))));\n        float d = length(p - vec2(x, y));\n        float v = clamp(1.6 - 2.0 * d, 0.0, 1.0);\n        // Leaves catch the light as they turn: brightness flickers gently twice a fall.\n        v *= 0.8 + 0.2 * sin(TAU * (2.0 * speed * iPhase + hash(vec2(fk, 6.0))));\n        col = max(col, v * mix(vec3(1.0, 0.62, 0.05), vec3(1.0, 0.85, 0.35), hash(vec2(fk, 7.0))));\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   },
