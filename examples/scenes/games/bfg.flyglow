{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "BFG 9000",
   "ru": "BFG 9000"
  },
  "description": {
   "en": "The BFG charging up and firing.",
   "ru": "BFG заряжается и стреляет."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Plasma",
     "ru": "Плазма"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#4dff40"
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 0,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "group": "Doom",
  "cover": 0.5,
  "tags": [
   "doom",
   "bfg",
   "plasma",
   "weapon",
   "дум",
   "бфг",
   "плазма"
  ],
  "order": 111
 },
 "loopSeconds": 4.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "BFG",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 115.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// BFG 9000: a ball of green plasma charges up in the middle, crackling, then lets go: a flash and a ring of\n// green light rush out over the dock. Loops through iPhase: keep \"Loop crossfade\" at 0.\nconst float PI2 = 6.2831853;\nfloat h(vec2 p) { vec3 q = fract(vec3(p.xyx) * 0.1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = (fragCoord - vec2(0.5, 0.62) * iResolution.xy) / iResolution.y;\n    float t = iPhase;\n    float r = length(p);\n    float charge = smoothstep(0.0, 0.7, t) * step(t, 0.7);\n    vec3 col = vec3(0.0);\n    // The ball grows and churns while it charges.\n    float ball = 0.06 + 0.16 * charge;\n    float a = atan(p.y, p.x);\n    float edge = ball * (1.0 + 0.15 * sin(7.0 * a + PI2 * 6.0 * t));\n    col += vec3(0.3, 1.0, 0.25) * smoothstep(edge, edge * 0.6, r) * (0.6 + 0.4 * charge);\n    col += vec3(0.85, 1.0, 0.8) * smoothstep(edge * 0.5, 0.0, r) * charge;\n    // Crackles round it.\n    float c = h(floor(p * 30.0) + floor(t * 16.0));\n    col += vec3(0.4, 1.0, 0.3) * step(0.94, c) * smoothstep(edge * 2.4, edge, r) * charge;\n    // The shot: a flash and a ring rushing out.\n    float f = (t - 0.7) / 0.3;\n    if (f >= 0.0) {\n        float ring = r - 0.9 * f;\n        col += vec3(0.4, 1.0, 0.3) * exp(-ring * ring / 0.006) * (1.0 - f);\n        col += vec3(0.6, 1.0, 0.55) * exp(-8.0 * f) * 0.6;\n    }\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
