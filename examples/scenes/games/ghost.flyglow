  },
  {
   "name": "Scan",
   "visible": true,
   "opacity": 1.0,
   "blend": 2,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Ghost scan: a cone of blue light from the eye sweeps left and right over the lower dock, with a brighter\n// scan line running down it. Lit only between 0.5 and 0.85 of the loop; black elsewhere, so the layer sits in\n// Screen mode. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border, so no light leaks into the neighbours; keeps about\n// 2/3 of the light, which brightness 120% evens out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins).\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    vec2 eye = vec2(0.0, -2.2);\n    float u = (iPhase - 0.5) / 0.35;                 // 0..1 over the scan\n    vec3 col = vec3(0.0);\n    if (u > 0.0 && u < 1.0 && p.y > 0.4) {\n        float on = smoothstep(0.0, 0.12, u) * (1.0 - smoothstep(0.85, 1.0, u));\n        float aim = 0.55 * sin(TAU * u);             // sweep: right, back, left, back\n        vec2 d = p - eye;\n        float ang = atan(d.x, d.y);                  // 0 straight down\n        float cone = 1.0 - smoothstep(0.22, 0.36, abs(ang - aim));\n        float line = exp(-pow(length(d) - mod(u * 24.0, 8.0) - 2.0, 2.0) / 0.5);\n        col = vec3(0.15, 0.6, 1.0) * cone * on * (0.7 + 0.3 * line) + vec3(0.6, 0.9, 1.0) * cone * on * 0.4 * line;\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
