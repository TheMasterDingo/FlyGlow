  },
  {
   "name": "Explosion",
   "visible": true,
   "opacity": 1.0,
   "blend": 2,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Creeper explosion: a white flash, then a ragged fireball and a shock ring rush out from the face,\n// creeper chunks and sparks fly apart and fall, the fire cools to red embers and grey smoke rolls up\n// and thins out. Black for the rest of the loop, so the layer sits on the creeper in Screen mode.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\nconst float T0 = 0.76;    // phase where it goes off\nconst float DUR = 0.17;   // share of the loop the explosion lasts\n\nfloat vnoise(vec2 p)\n{\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),\n               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\nfloat fbm(vec2 p) { return 0.65 * vnoise(p) + 0.35 * vnoise(p * 2.1 + 7.3); }\n\n// Heat 0..1: black, deep red, orange, yellow, white.\nvec3 fire(float h)\n{\n    vec3 c = mix(vec3(0.0), vec3(0.6, 0.03, 0.0), smoothstep(0.0, 0.25, h));\n    c = mix(c, vec3(1.0, 0.32, 0.0), smoothstep(0.25, 0.5, h));\n    c = mix(c, vec3(1.0, 0.72, 0.08), smoothstep(0.5, 0.75, h));\n    return mix(c, vec3(1.0, 0.98, 0.85), smoothstep(0.75, 1.0, h));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    float t = (iPhase - T0) / DUR;\n    vec3 col = vec3(0.0);\n    if (t >= 0.0 && t < 1.0) {\n        vec2 c = vec2(0.0, -1.3);                       // the middle of the creeper's face\n        vec2 d = p - c;\n        float r = length(d);\n        float ang = atan(d.y, d.x);\n\n        // Fireball: grows fast then slows, ragged at the edge, cools from white through orange to red.\n        float grow = 1.0 - pow(1.0 - clamp(t / 0.5, 0.0, 1.0), 2.0);\n        float rag = 0.8 + 0.4 * vnoise(vec2(ang * 1.6 + 5.0, t * 3.0));\n        float R = 11.0 * grow * rag;\n        float n = fbm(p * 0.8 + vec2(0.0, 5.0 * t));\n        float heat = 1.3 - 1.45 * t - 0.45 * r / max(R, 0.5) + 0.8 * (n - 0.5);\n        col = fire(clamp(heat, 0.0, 1.0)) * smoothstep(R + 0.4, R - 0.8, r);\n\n        // Shock ring racing ahead of the fire.\n        float rs = 20.0 * pow(t, 0.6);\n        col += vec3(1.0, 0.85, 0.5) * exp(-(r - rs) * (r - rs) / 1.2) * max(0.0, 1.0 - t / 0.32);\n\n        // Smoke rolls up as the fire dies, then thins out.\n        float s = fbm(p * 0.45 + vec2(1.7, 4.0 * t));\n        float smoke = smoothstep(0.42, 0.7, s) * smoothstep(0.3, 0.55, t) * (1.0 - smoothstep(0.7, 1.0, t));\n        col = mix(col, vec3(0.30, 0.28, 0.27), smoke * 0.85);\n\n        // Chunks of the block (red) and sparks (yellow) fly out and fall.\n        for (int k = 0; k < 14; k++) {\n            float fk = float(k);\n            float a = TAU * (fk + 0.6 * hash(vec2(fk, 1.0))) / 14.0;\n            float v = 13.0 + 9.0 * hash(vec2(fk, 2.0));\n            float tt = t * (0.9 + 0.2 * hash(vec2(fk, 3.0)));\n            vec2 pos = c + vec2(cos(a), sin(a)) * v * tt + vec2(0.0, 14.0 * tt * tt);\n            float bit = clamp(1.4 - 2.2 * length(p - pos), 0.0, 1.0) * (1.0 - smoothstep(0.35, 0.7, t));\n            vec3 bc = mod(fk, 2.0) < 0.5 ? vec3(0.95, 0.12, 0.04) : vec3(1.0, 0.85, 0.3);\n            col = mix(col, bc, bit);\n        }\n\n        // The flash: white for a frame, then a warm afterglow rather than a grey haze.\n        float f = exp(-t / 0.02);\n        col = max(col, mix(vec3(1.0, 0.8, 0.4), vec3(1.0), f) * f);\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
