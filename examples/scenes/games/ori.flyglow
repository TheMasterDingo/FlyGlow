{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Ori",
   "ru": "Ори"
  },
  "description": {
   "en": "Ori's light flying through a blue forest.",
   "ru": "Огонёк Ори летает по синему лесу."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#b4f2ff"
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 0,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "group": "Indie",
  "cover": 0.1,
  "tags": [
   "ori",
   "spirit",
   "forest",
   "indie",
   "ори",
   "дух",
   "инди"
  ],
  "order": 423
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Spirit light",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 115.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Ori: a white spirit light drifts in a slow figure eight through a deep blue forest, a trail of sparks\n// behind it. Loops through iPhase: keep \"Loop crossfade\" at 0.\nconst float PI2 = 6.2831853;\n\nvec2 path(float t) { return vec2(0.55 * sin(PI2 * t), 0.18 * sin(2.0 * PI2 * t) + 0.08); }\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n    float t = iPhase;\n    vec3 col = mix(vec3(0.0, 0.10, 0.22), vec3(0.0, 0.05, 0.12), fragCoord.y / iResolution.y);\n    for (int k = 0; k < 8; k++) {\n        float lag = float(k) * 0.018;\n        vec2 q = p - path(t - lag);\n        float r = length(q);\n        float a = k == 0 ? 1.0 : 0.55 * (1.0 - float(k) / 8.0);\n        float size = k == 0 ? 0.09 : 0.035;\n        col += vec3(0.7, 0.95, 1.0) * a * smoothstep(size, size * 0.3, r);\n    }\n    vec2 q = p - path(t);\n    col += vec3(0.3, 0.7, 1.0) * 0.5 * exp(-dot(q, q) / 0.02);\n    fragColor = vec4(col, 1.0);\n}\n"
   }
  }
 ]
}
