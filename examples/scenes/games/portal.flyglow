{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Portal",
   "ru": "Portal"
  },
  "description": {
   "en": "Blue and orange portals; the Companion Cube passes through.",
   "ru": "Синий и оранжевый порталы, через них проходит куб-компаньон."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Portal colours",
     "ru": "Цвета порталов"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#3399ff"
   },
   {
    "type": "number",
    "label": {
     "en": "Glow",
     "ru": "Свечение"
    },
    "min": 0,
    "max": 100,
    "step": 1,
    "suffix": "%",
    "targets": [
     {
      "layer": 0,
      "prop": "glow",
      "from": 0,
      "to": 1
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "portal",
   "valve",
   "aperture",
   "companion cube",
   "portal gun"
  ],
  "order": 40,
  "group": "Valve"
 },
 "loopSeconds": 6.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Portals",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 120.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Portal: a blue and an orange portal with swirling rims on a dark test-chamber wall; once a loop the\n// Companion Cube slides into the blue one and out of the orange one. Loops through iPhase: keep \"Loop crossfade\"\n// at 0.\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hash without sine (Dave Hoskins): stays uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nconst float TAU = 6.2831853;\n\n// Rim and inside of a portal centred at c: returns rgb, alpha in a.\nvec4 portal(vec2 p, vec2 c, vec3 rim, vec3 deep)\n{\n    vec2 d = (p - c) / vec2(2.1, 4.2);\n    float r = length(d);\n    if (r > 1.12) return vec4(0.0);\n    float ang = atan(d.y, d.x);\n    float swirl = 0.5 + 0.5 * sin(3.0 * ang + TAU * 2.0 * iPhase + 6.0 * r);\n    if (r > 0.78) return vec4(mix(rim * 0.6, rim, swirl), 1.0);\n    return vec4(deep * (0.5 + 0.5 * swirl * r), 1.0);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 q = dockPos(fragCoord);\n    vec3 led = ledCell(q);\n    vec2 p = led.xy;\n    // Wall: dark panels with seams.\n    vec3 col = vec3(0.10, 0.10, 0.12) * (mod(floor(p.x / 3.0) + floor((p.y + 7.0) / 3.0), 2.0) < 0.5 ? 1.0 : 0.75);\n    vec2 cb = vec2(-3.6, -2.3), co = vec2(3.6, -2.3);\n    vec4 b = portal(p, cb, vec3(0.2, 0.6, 1.0), vec3(0.02, 0.12, 0.35));\n    vec4 o = portal(p, co, vec3(1.0, 0.5, 0.05), vec3(0.35, 0.12, 0.02));\n    col = mix(col, b.rgb, b.a);\n    col = mix(col, o.rgb, o.a);\n\n    // The cube: in from the left edge to the blue portal, then out of the orange one to the right edge.\n    float t = fract(iPhase + 0.5);\n    float cx = 99.0;\n    if (t < 0.25) cx = mix(-8.5, cb.x, t / 0.25);\n    else if (t > 0.30 && t < 0.55) cx = mix(co.x, 8.5, (t - 0.30) / 0.25);\n    vec2 cc = vec2(cx, -2.3);\n    vec2 dc = abs(p - cc);\n    bool inBlue = t < 0.25 && p.x > cb.x;\n    bool inOrange = t > 0.30 && t < 0.55 && p.x < co.x;\n    if (max(dc.x, dc.y * 1.15) < 1.6 && !inBlue && !inOrange) {\n        col = vec3(0.62, 0.62, 0.66);\n        if (length(p - cc) < 0.7) col = vec3(1.0, 0.35, 0.65);\n    }\n    fragColor = vec4(col * ledCore(q, led), 1.0);\n}\n"
   }
  }
 ]
}
