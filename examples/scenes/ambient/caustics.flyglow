{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Pool caustics",
   "ru": "Блики в бассейне"
  },
  "description": {
   "en": "Light ripples on the blue floor of a pool.",
   "ru": "Блики света на голубом дне бассейна."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#00527a"
   },
   {
    "type": "opacity",
    "label": {
     "en": "Brightness",
     "ru": "Яркость"
    },
    "targets": [
     {
      "layer": 0
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "water",
   "pool",
   "caustics",
   "summer",
   "calm",
   "вода",
