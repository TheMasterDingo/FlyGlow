{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Sunset glow",
   "ru": "Закат"
  },
  "description": {
   "en": "A violet to orange sunset sky with drifting clouds.",
   "ru": "Закатное небо от фиолетового до оранжевого, плывут облака."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Colour",
     "ru": "Цвет"
    },
    "targets": [
     {
      "layer": 0
     }
    ],
    "base": "#e60073"
   },
   {
    "type": "opacity",
    "label": {
     "en": "Brightness",
     "ru": "Яркость"
    },
    "targets": [
     {
      "layer": 0
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "sunset",
   "evening",
   "warm",
   "закат",
   "вечер"
  ],
  "order": 10
 },
 "loopSeconds": 20.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Sunset",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Sunset glow: a deep violet sky warms through magenta to orange above a low gold sun in the tip of the\n// dock; high clouds lit pink and low violet ones drift slowly across, and the sun's glow breathes.\n// Everything moves through whole cycles per loop. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst vec2 SUN = vec2(0.0, 5.0);\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = dockPos(fragCoord);\n    float T = TAU * iPhase;\n    float h = clamp((p.y + 6.5) / 13.0, 0.0, 1.0);                 // 0 at the top, 1 at the tip\n    vec3 sky = mix(vec3(0.22, 0.0, 0.55), vec3(0.9, 0.0, 0.45), smoothstep(0.0, 0.45, h));\n    sky = mix(sky, vec3(1.0, 0.18, 0.05), smoothstep(0.4, 0.75, h));\n    sky = mix(sky, vec3(1.0, 0.45, 0.0), smoothstep(0.75, 1.0, h));\n\n    // Cloud bands: long streaks across the sky, broken into pieces that drift sideways, a whole wave per loop.\n    float c1 = smoothstep(0.1, 0.6, 0.5 + 0.5 * sin(0.5 * p.x - T + 0.8 * sin(0.3 * p.x + T)));\n    float c2 = smoothstep(0.1, 0.6, 0.5 + 0.5 * sin(0.42 * p.x + T + 1.7));\n    float y1 = (p.y + 3.0 + 0.4 * sin(0.5 * p.x + T)) / 0.9;\n    float y2 = (p.y - 1.6 + 0.35 * sin(0.45 * p.x - T + 2.0)) / 0.8;\n    float band1 = exp(-y1 * y1 * y1 * y1) * c1;\n    float band2 = exp(-y2 * y2 * y2 * y2) * c2;\n    vec3 col = mix(sky, vec3(1.0, 0.45, 0.25), 0.9 * band1);        // high clouds lit gold-pink from below\n    col = mix(col, vec3(0.3, 0.0, 0.45), 0.9 * band2);             // low clouds dark against the glow\n\n    // The sun and its breathing glow.\n    float r = length(p - SUN);\n    float breath = 0.5 - 0.5 * cos(T);\n    col += vec3(1.0, 0.45, 0.0) * (0.35 + 0.3 * breath) * exp(-r * r / 7.0);\n    col = mix(col, vec3(1.0, 0.8, 0.3), smoothstep(1.9, 1.5, r));\n    fragColor = vec4(min(col, vec3(1.0)), 1.0);\n}\n"
   }
  }
 ]
}
