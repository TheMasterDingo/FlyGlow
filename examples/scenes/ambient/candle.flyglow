 },
 "loopSeconds": 8.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Candle",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Candle: one flame standing in the narrow tip of the dock, white at the core, gold and orange round it,\n// swaying and stretching a little as the air moves, in a soft red halo. The flicker is smooth noise on a\n// circle through time, so it never jumps and the loop closes. Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nconst vec2 BASE = vec2(0.0, 5.6);    // the bottom of the flame\n\n// Smooth flicker in -1..1 that loops: noise read along a circle.\nfloat flicker(float seed, float rate)\n{\n    float a = TAU * iPhase * rate;\n    return 2.0 * noise3(vec3(1.3 * cos(a) + seed, 1.3 * sin(a), seed * 0.37)) - 1.0;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = dockPos(fragCoord);\n    float sway = 0.6 * flicker(3.0, 3.0);\n    float stretch = 1.0 + 0.12 * flicker(11.0, 4.0);\n    float glow = 0.9 + 0.1 * flicker(23.0, 5.0);\n\n    // Teardrop: a round belly low down, drawn out to a point at the top; the tip sways more than the belly.\n    vec2 d = p - BASE;\n    float len = 7.5 * stretch;\n    float up = clamp(-d.y / len, 0.0, 1.0);                         // 0 at the belly, 1 at the tip\n    d.x -= sway * up * up * 3.0;\n    float halfWidth = mix(2.6, 0.0, pow(up, 0.6));\n    float body = d.y > 0.0 ? 1.0 - length(d / vec2(2.6, 1.4)) : 1.0 - abs(d.x) / max(halfWidth, 0.01);\n    body = clamp(body, 0.0, 1.0) * step(-d.y, len);\n\n    vec3 col = vec3(0.0);\n    col = mix(col, vec3(1.0, 0.22, 0.0), smoothstep(0.0, 0.2, body));\n    col = mix(col, vec3(1.0, 0.55, 0.05), smoothstep(0.2, 0.45, body));\n    col = mix(col, vec3(1.0, 0.92, 0.7), smoothstep(0.45, 0.75, body) * (1.0 - 0.7 * up));\n    // Halo: the candle lights the dark round it, deep red fading out.\n    float r = length((p - BASE - vec2(0.0, -3.0)) / vec2(1.0, 1.15));\n    float halo = 0.25 + 0.75 * exp(-r * r / 30.0) * glow;\n    col = max(col, vec3(0.9 * halo, 0.1 * halo * halo * halo, 0.0));\n    fragColor = vec4(min(col * glow, vec3(1.0)), 1.0);\n}\n"
   }
  }
 ]
}
