      "layer": 0
     }
    ],
    "base": "#ff0080"
   },
   {
    "type": "toggle",
    "label": {
     "en": "Rain",
     "ru": "Дождь"
    },
    "targets": [
     {
      "layer": 1
     }
    ]
   },
   {
    "type": "opacity",
    "label": {
     "en": "Brightness",
     "ru": "Яркость"
    },
    "targets": [
     {
      "layer": 0
     },
     {
      "layer": 1
     }
    ]
   }
  ],
  "cover": 0.0,
  "tags": [
   "neon",
   "rain",
   "night",
   "city",
   "неон",
   "дождь",
   "ночь"
  ],
  "order": 50
 },
 "loopSeconds": 12.0,
 "brightness": 100,
 "outputGamma": 1.4,
 "layers": [
  {
   "name": "Neon night",
   "visible": true,
   "opacity": 1.0,
   "blend": 0,
   "effect": {
    "type": "shader",
    "params": {
     "speed": 1.0,
     "seam": 0.0,
     "brightness": 100.0,
     "saturation": 100.0,
     "zoom": 1.0,
     "panX": 0.0,
     "panY": 0.0
    },
    "source": "// Rainy night neon: a deep blue night with blurred neon signs, pink, cyan and violet, glowing through wet\n// glass; each glow swells and fades softly at its own whole rate per loop.\n// Loops through iPhase: keep \"Loop crossfade\" at 0.\n\nconst float TAU = 6.2831853;\n// The middle of the dock's rounded triangle, about equally far from its three corners.\nconst vec2 MID = vec2(0.0, -1.6);\n\n// Dock layout units: one LED pitch = 1, x to the right, y down, 0 at the centre of the LEDs.\n// The frame spans the dock outline's bounding box: 17.82 x 16.17 units, centred at (-0.018, 0.220).\nvec2 dockPos(vec2 fragCoord)\n{\n    return (fragCoord / iResolution.xy - 0.5) * vec2(17.82, -16.17) + vec2(-0.018, 0.220);\n}\n\n// Centre of the LED nearest to p, so every LED gets one crisp colour; .z = row 0..15 from the top.\nvec3 ledCell(vec2 p)\n{\n    float r0 = floor((p.y + 6.477) / 0.8636 + 0.5);\n    vec3 best = vec3(0.0);\n    float bestD = 1e9;\n    for (int k = -1; k <= 1; k++) {\n        float row = clamp(r0 + float(k), 0.0, 15.0);\n        float n = row <= 2.0 ? 14.0 + row : 18.0 - row;\n        float off = mod(n, 2.0) == 0.0 ? 0.5 : 0.0;\n        float x = clamp(floor(p.x - off + 0.5) + off, -0.5 * (n - 1.0), 0.5 * (n - 1.0));\n        vec2 c = vec2(x, -6.477 + row * 0.8636);\n        float d = dot(p - c, p - c);\n        if (d < bestD) {\n            bestD = d;\n            best = vec3(c, row);\n        }\n    }\n    return best;\n}\n\n// 1 inside a disc around the LED centre, 0 on the cell border: FlyGlow averages each LED's whole cell, and\n// light on the border would leak into the neighbours. Keeps about 2/3 of the light; brightness 120% evens it out.\nfloat ledCore(vec2 p, vec3 led)\n{\n    return step(length(p - led.xy), 0.46);\n}\n\n// Hashes without sine (Dave Hoskins): uncorrelated between neighbouring integers on every GPU.\nfloat hash(vec2 p)\n{\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat hash13(vec3 p3)\n{\n    p3 = fract(p3 * 0.1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nfloat noise3(vec3 p)\n{\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),\n                  mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y);\n    float b = mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),\n                  mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y);\n    return mix(a, b, f.z);\n}\n\nfloat fbm3(vec3 p) { return 0.6 * noise3(p) + 0.3 * noise3(p * 2.1 + 5.0) + 0.1 * noise3(p * 4.3 + 9.0); }\n\n// 1 inside, 0 outside a shape given its signed distance in LED pitches, with a half-LED ramp across the edge,\n// so moving edges glide between LEDs without a wide muddy fringe.\nfloat inside(float sd) { return clamp(0.5 - 2.0 * sd, 0.0, 1.0); }\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 p = dockPos(fragCoord);\n    float T = TAU * iPhase;\n    vec3 col = mix(vec3(0.0, 0.02, 0.18), vec3(0.03, 0.0, 0.1), clamp((p.y + 6.5) / 13.0, 0.0, 1.0));\n    vec3 cols[4] = vec3[4](vec3(1.0, 0.0, 0.5), vec3(0.0, 0.75, 1.0), vec3(0.5, 0.0, 1.0), vec3(1.0, 0.1, 0.3));\n    vec2 at[4] = vec2[4](vec2(-3.6, -3.8), vec2(3.4, -2.6), vec2(-0.6, 0.6), vec2(2.0, 3.6));\n    vec2 size[4] = vec2[4](vec2(2.6, 1.3), vec2(1.6, 2.4), vec2(2.4, 1.6), vec2(1.4, 1.4));\n    float rate[4] = float[4](1.0, 2.0, 1.0, 3.0);\n    for (int i = 0; i < 4; i++) {\n        float fi = float(i);\n        vec2 d = (p - at[i] - vec2(0.3 * sin(T + fi), 0.0)) / size[i];\n        float level = 0.7 + 0.3 * (0.5 + 0.5 * sin(rate[i] * T + 1.9 * fi));\n        col += cols[i] * 1.15 * level * exp(-0.8 * dot(d, d));\n    }\n    fragColor = vec4(min(col, vec3(1.0)), 1.0);\n}\n"
   }
  },
  {
   "name": "Rain",
   "visible": true,
   "opacity": 0.8,
   "blend": 2,
   "effect": {
    "type": "rain",
    "params": {
     "gradient": [
      {
       "pos": 0.0,
       "color": "#5a8cff"
      },
      {
       "pos": 1.0,
       "color": "#b4dcff"
      }
     ],
     "density": 40.0,
     "length": 3.0,
     "cycles": 3,
     "seed": 7,
     "transparent": true,
     "background": "#000000"
    }
   }
  }
 ]
}
