{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Neon rain",
   "ru": "Неоновый дождь"
  },
  "description": {
   "en": "Blurred neon lights behind a rainy window.",
   "ru": "Размытый неон за окном в дождь."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
     "en": "Neon colour",
     "ru": "Цвет неона"
    },
    "targets": [
