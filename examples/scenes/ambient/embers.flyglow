{
 "format": "flyglow",
 "version": 1,
 "preset": {
  "title": {
   "en": "Embers",
   "ru": "Угли"
  },
  "description": {
   "en": "Glowing coals, slowly brightening and dimming.",
   "ru": "Тлеющие угли медленно разгораются и тускнеют."
  },
  "controls": [
   {
    "type": "hue",
    "label": {
